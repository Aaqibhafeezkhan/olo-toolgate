{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolGate protected tenant initialization manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "defaultTenantAlias", "tenants"],
  "properties": {
    "formatVersion": {"const": 1},
    "defaultTenantAlias": {"$ref": "#/$defs/alias"},
    "commonImports": {"$ref": "#/$defs/imports"},
    "tenants": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["alias", "name", "hosts", "administratorProvisioningRef"],
        "properties": {
          "alias": {"$ref": "#/$defs/alias"},
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "hosts": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
          "administratorProvisioningRef": {"$ref": "#/$defs/path"},
          "imports": {"$ref": "#/$defs/imports"}
        }
      }
    }
  },
  "$defs": {
    "alias": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "imports": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/path"}}
  }
}

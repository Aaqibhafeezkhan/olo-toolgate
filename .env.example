# OLO ToolGate development defaults.
# Copy to .env only when local implementation requires overrides.
# Never commit real credentials.

TOOLGATE_ENV=development
TOOLGATE_LOG_LEVEL=info

# Setup administrator email; used only on first creation, never on restart/upgrade.
TOOLGATE_ADMIN_EMAIL=admin@admin.com

# Intended local ports
TOOLGATE_CONTROL_PORT=8080
TOOLGATE_GATEWAY_PORT=8081
TOOLGATE_UI_PORT=3000
TOOLGATE_MOCK_MCP_PORT=8090

# Future dev dependencies
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=toolgate
POSTGRES_USER=toolgate
POSTGRES_PASSWORD=dev-only-change-me

# Marketplace / object storage development
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=toolgate-dev
OBJECT_STORE_ACCESS_KEY=dev-only
OBJECT_STORE_SECRET_KEY=dev-only

# Do not put production keys, OAuth secrets, signing keys, or customer credentials here.

import unittest
import {{pythonPackage}} as tools
from toolgate.testing import ToolHarness


class ToolsTest(unittest.TestCase):
    def test_hello(self):
        with ToolHarness([tools]) as harness:
            self.assertEqual({"message": "Hello World"}, harness.call("hello").output)


if __name__ == "__main__":
    unittest.main()

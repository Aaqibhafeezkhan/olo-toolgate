[build-system]
requires = ["setuptools>=61"]
build-backend = "setuptools.build_meta"

[project]
name = "{{name}}"
version = "0.1.0"
requires-python = ">=3.10"
dependencies = ["toolgate-sdk=={{sdkVersion}}"]

[tool.setuptools.packages.find]
where = ["src"]

[tool.toolgate]
descriptor_generation = 1
packages = ["{{pythonPackage}}"]

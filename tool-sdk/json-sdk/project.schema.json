{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ololabs.io/toolgate/json-sdk/project.schema.json",
  "title": "ToolGate JSON SDK project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sdkVersion", "id", "name", "publisher", "version", "tools"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sdkVersion": {"type": "string", "minLength": 1, "maxLength": 128},
    "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$", "maxLength": 128},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "publisher": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$", "maxLength": 128},
    "version": {"type": "string", "minLength": 5, "maxLength": 128},
    "tools": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/tool"}}
  },
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "description", "maxLength"],
      "properties": {
        "type": {"const": "STRING"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1024},
        "default": {"type": "string", "minLength": 1, "maxLength": 4096},
        "maxLength": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "expression": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["literal"], "properties": {"literal": {"type": "string", "maxLength": 4096}}},
        {"type": "object", "additionalProperties": false, "required": ["input"], "properties": {"input": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"}}}
      ]
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["concat"],
      "properties": {"concat": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/expression"}}}
    },
    "event": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["level", "message"], "properties": {
          "level": {"enum": ["debug", "info", "warn", "error"]}, "message": {"type": "string", "minLength": 1, "maxLength": 512}
        }},
        {"type": "object", "additionalProperties": false, "required": ["fraction", "message"], "properties": {
          "fraction": {"type": "number", "minimum": 0, "maximum": 1}, "message": {"type": "string", "minLength": 1, "maxLength": 512}
        }}
      ]
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "kind", "title", "description", "inputs", "output"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$", "maxLength": 64},
        "kind": {"enum": ["CLIENT", "SERVER"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 100},
        "description": {"type": "string", "minLength": 1, "maxLength": 2048},
        "inputs": {"type": "object", "maxProperties": 16, "propertyNames": {"pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"}, "additionalProperties": {"$ref": "#/$defs/input"}},
        "output": {"type": "object", "minProperties": 1, "maxProperties": 16, "propertyNames": {"pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"}, "additionalProperties": {"$ref": "#/$defs/output"}},
        "events": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/event"}}
      }
    }
  }
}

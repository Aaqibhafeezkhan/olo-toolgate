{
  "$schema": "../case.schema.json",
  "suite": "protocol",
  "area": "mcp-core",
  "title": "MCP 2026-07-28 core",
  "sources": [
    "plan.md §10.1",
    "ADR 018"
  ],
  "cases": [
    {
      "id": "mcp-core/discover",
      "title": "server/discover advertises versions and extensions",
      "requirements": [
        "plan.md §10.1"
      ],
      "level": "component",
      "targets": [
        "gateway",
        "java",
        "python",
        "typescript",
        "dotnet"
      ],
      "perTarget": true,
      "when": "A client calls server/discover",
      "then": [
        "Versions, capabilities, extensions including io.modelcontextprotocol/tasks, and server info"
      ],
      "status": "authored"
    },
    {
      "id": "mcp-core/per-request-meta",
      "title": "Every request carries version and capabilities in _meta",
      "requirements": [
        "plan.md §10.1"
      ],
      "level": "component",
      "targets": [
        "gateway",
        "java",
        "python",
        "typescript",
        "dotnet"
      ],
      "perTarget": true,
      "when": "Requests omit protocolVersion, omit clientCapabilities, and carry both",
      "then": [
        "Missing values give a JSON-RPC error; complete requests succeed"
      ],
      "status": "authored"
    },
    {
      "id": "mcp-core/unsupported-version",
      "title": "An unsupported version gets -32022 with the supported list",
      "requirements": [
        "ADR 018"
      ],
      "level": "component",
      "targets": [
        "gateway",
        "java",
        "python",
        "typescript",
        "dotnet"
      ],
      "perTarget": true,
      "when": "A request names 2024-11-05",
      "then": [
        "UnsupportedProtocolVersion -32022 listing supported versions"
      ],
      "status": "authored"
    },
    {
      "id": "mcp-core/header-mismatch",
      "title": "Header and body disagreement gets -32020",
      "requirements": [
        "ADR 018"
      ],
      "level": "component",
      "targets": [
        "gateway",
        "java",
        "python",
        "typescript",
        "dotnet"
      ],
      "perTarget": true,
      "when": "Mcp-Method or Mcp-Name headers differ from the body",
      "then": [
        "HeaderMismatch -32020"
      ],
      "status": "authored"
    },
    {
      "id": "mcp-core/missing-capability",
      "title": "A missing required capability gets -32021",
      "requirements": [
        "ADR 018"
      ],
      "level": "component",
      "targets": [
        "gateway",
        "java",
        "python",
        "typescript",
        "dotnet"
      ],
      "perTarget": true,
      "when": "A client without Tasks calls an async tool directly",
      "then": [
        "MissingRequiredClientCapability -32021 naming the extension"
      ],
      "status": "authored"
    },
    {
      "id": "mcp-core/result-type",
      "title": "Every result carries resultType",
      "requirements": [
        "plan.md §10.1"
      ],
      "level": "component",
      "targets": [
        "gateway",
        "java",
        "python",
        "typescript",
        "dotnet"
      ],
      "perTarget": true,
      "when": "Calls end complete, input_required and task",
      "then": [
        "resultType is set on every result"
      ],
      "status": "authored"
    },
    {
      "id": "mcp-core/no-session",
      "title": "Each request is authenticated on its own",
      "requirements": [
        "plan.md §10.1"
      ],
      "level": "component",
      "targets": [
        "gateway"
      ],
      "when": "A second request reuses nothing but omits the bearer",
      "then": [
        "401"
      ],
      "status": "authored"
    },
    {
      "id": "mcp-core/listen",
      "title": "subscriptions/listen delivers toolsListChanged",
      "requirements": [
        "plan.md §10.1"
      ],
      "level": "component",
      "targets": [
        "gateway",
        "java",
        "python",
        "typescript",
        "dotnet"
      ],
      "perTarget": true,
      "when": "A client listens with toolsListChanged and the catalog changes",
      "then": [
        "A notification tagged with the subscriptionId"
      ],
      "status": "authored"
    },
    {
      "id": "mcp-core/log-level",
      "title": "Logging is per request",
      "requirements": [
        "plan.md §10.1"
      ],
      "level": "component",
      "targets": [
        "gateway"
      ],
      "when": "A request sets io.modelcontextprotocol/logLevel warn",
      "then": [
        "Only warn and error log frames are returned"
      ],
      "status": "authored"
    },
    {
      "id": "mcp-core/no-ping",
      "title": "ping is not on the modern path",
      "requirements": [
        "plan.md §10.1"
      ],
      "level": "component",
      "targets": [
        "gateway"
      ],
      "when": "A 2026-07-28 request calls ping",
      "then": [
        "Method not found"
      ],
      "status": "authored"
    },
    {
      "id": "mcp-core/trace-propagation",
      "title": "Trace context in _meta is propagated",
      "requirements": [
        "plan.md §10.1"
      ],
      "level": "integration",
      "targets": [
        "gateway",
        "tool-host"
      ],
      "when": "A request carries traceparent, tracestate and baggage",
      "then": [
        "The tool input carries the same traceparent"
      ],
      "status": "authored"
    },
    {
      "id": "mcp-core/catalog-cache",
      "title": "tools/list is deterministic and privately cacheable",
      "requirements": [
        "plan.md §10.3"
      ],
      "level": "component",
      "targets": [
        "gateway"
      ],
      "when": "tools/list is called twice, then with different extensions",
      "then": [
        "Same order and bytes; ttlMs and cacheScope private",
        "outputSchema and task support appear only where the version and extensions allow"
      ],
      "status": "authored"
    },
    {
      "id": "mcp-core/schemas-exact",
      "title": "Schemas are served exactly as in the descriptor",
      "requirements": [
        "tool-sdk/spec/protocol-layer.md §2"
      ],
      "level": "component",
      "targets": [
        "gateway",
        "java",
        "python",
        "typescript",
        "dotnet"
      ],
      "perTarget": true,
      "when": "A tool uses composition, conditional and anchor keywords",
      "then": [
        "inputSchema and outputSchema are byte-identical to the descriptor"
      ],
      "status": "authored"
    }
  ]
}

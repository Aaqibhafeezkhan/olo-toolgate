# =============================================================================
# OLO ToolGate
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets / local configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.db.example
!.env.cache.example
*.secret
*.secrets
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
secrets/
credentials/
private/
.local-secrets/

# -----------------------------------------------------------------------------
# Local ToolGate state
# -----------------------------------------------------------------------------
.dev/
.toolgate/
toolgate.dev.json
.data/
data/
runtime/
# source packages named runtime are code, not local state
!**/src/**/runtime/
artifacts/
quarantine/
hotfolder/
HotFolder/
# The HotFolder example package is code, not a local files area.
!examples/java-tools/hotfolder/
!**/src/**/hotfolder/
logs/
# Java source packages named logs are code, not local log output.
!**/src/**/logs/
tmp/
temp/
coverage/
reports/
benchmark-results/

# Keep checked-in example/sample data if explicitly under examples.
!docs/examples/
!examples/

# -----------------------------------------------------------------------------
# Rust
# -----------------------------------------------------------------------------
target/
**/target/
# Keep the workspace dependency lock committed from Module 00 onward.
# For binaries/applications, Cargo.lock should normally be committed.


# -----------------------------------------------------------------------------
# Gradle
# -----------------------------------------------------------------------------
.gradle/
**/.gradle/
!gradle/wrapper/gradle-wrapper.jar


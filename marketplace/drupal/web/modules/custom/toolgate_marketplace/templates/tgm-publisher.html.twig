{% set p = profile %}
<article class="tgm-publisher">
  <header class="tgm-publisher__header">
    {% if avatar %}<img class="tgm-avatar tgm-avatar--lg" src="{{ avatar }}" alt="" width="96" height="96">{% else %}<div class="tgm-avatar tgm-avatar--lg tgm-avatar--initial" aria-hidden="true">{{ p.displayName|first|upper }}</div>{% endif %}
    <div>
      <p class="tgm-publisher__slug"><code>{{ p.slug }}</code></p>
      {% if p.organization %}<p>{{ p.organization }}</p>{% endif %}
      <ul class="tgm-links">
        {% if p.websiteUrl %}<li><a href="{{ p.websiteUrl }}" rel="nofollow noopener noreferrer ugc">{{ 'Website'|t }}</a></li>{% endif %}
        {% if p.githubUrl %}<li><a href="{{ p.githubUrl }}" rel="nofollow noopener noreferrer ugc">GitHub</a></li>{% endif %}
        {% if p.linkedinUrl %}<li><a href="{{ p.linkedinUrl }}" rel="nofollow noopener noreferrer ugc">LinkedIn</a></li>{% endif %}
        {% if p.publicContactEmail %}<li><a href="mailto:{{ p.publicContactEmail }}">{{ p.publicContactEmail }}</a></li>{% endif %}
        {% if p.country %}<li>{{ p.country }}</li>{% endif %}
      </ul>
    </div>
  </header>
  {% if p.bio %}<div class="tgm-markdown">{{ bio }}</div>{% endif %}
  <p class="tgm-note">{{ 'Publisher details are supplied by the publisher.'|t }}</p>
  <h2>{{ 'Tools'|t }}</h2>
  {% if cards %}<div class="tgm-grid">{{ cards }}</div>{% else %}<p class="tgm-empty">{{ 'No published tools yet.'|t }}</p>{% endif %}
</article>

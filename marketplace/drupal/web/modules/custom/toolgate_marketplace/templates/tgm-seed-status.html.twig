{% if status is null %}
  <p>{{ 'The example seed has not run yet. The deploy job runs it after install or update.'|t }}</p>
{% else %}
  <p>{{ 'Status'|t }}: <span class="tgm-chip tgm-chip--{{ status.seed == 'complete' ? 'available' : 'rejected' }}">{{ status.seed }}</span> · {{ 'Checked'|t }} {{ status.checkedAt }}</p>
  {% if status.missing %}
    <table class="tgm-table">
      <thead><tr><th>{{ 'Package'|t }}</th><th>{{ 'Reason'|t }}</th></tr></thead>
      <tbody>{% for m in status.missing %}<tr><td><code>{{ m.id }}</code></td><td>{{ m.reason }}</td></tr>{% endfor %}</tbody>
    </table>
  {% endif %}
  {% set published_count = status.published|length %}
  {% set skipped_count = status.skipped|length %}
  <p>{% trans %}Published in the last run: {{ published_count }}. Unchanged: {{ skipped_count }}.{% endtrans %}</p>
  {% if status.unexpected %}<p>{{ 'Discovered but not in expected-packages.json:'|t }} {% for id in status.unexpected %}<code>{{ id }}</code> {% endfor %}</p>{% endif %}
{% endif %}

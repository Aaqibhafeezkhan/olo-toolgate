<div class="tgm-browse" data-tgm-browse>
  <form class="tgm-filters" action="{{ form.action }}" method="get" role="search" data-tgm-filters>
    <div class="tgm-filters__row">
      <label class="visually-hidden" for="tgm-q">{{ 'Search tools'|t }}</label>
      <input id="tgm-q" type="search" name="q" value="{{ form.values.q }}" placeholder="{{ 'Search tools'|t }}" maxlength="200">
      <label for="tgm-sort">{{ 'Sort'|t }}</label>
      <select id="tgm-sort" name="sort">
        <option value="newest"{% if form.values.sort != 'name' %} selected{% endif %}>{{ 'Newest'|t }}</option>
        <option value="name"{% if form.values.sort == 'name' %} selected{% endif %}>{{ 'Name'|t }}</option>
      </select>
      {% for name in ['category', 'runtime', 'tag', 'publisher'] %}
        {% if form.values[name] %}<input type="hidden" name="{{ name }}" value="{{ form.values[name] }}">{% endif %}
      {% endfor %}
      <button type="submit" class="button">{{ 'Apply'|t }}</button>
      <button type="button" class="button tgm-filters__toggle" aria-controls="tgm-facets" aria-expanded="false" data-tgm-facets-toggle>{{ 'Filters'|t }}</button>
    </div>
  </form>
  <div class="tgm-browse__layout">
    <aside id="tgm-facets" class="tgm-facets" aria-label="{{ 'Filters'|t }}">
      {% for name, label in {category: 'Category'|t, runtime: 'Runtime'|t, tag: 'Tags'|t, publisher: 'Publisher'|t} %}
        {% if facets[name] %}
          <section class="tgm-facet">
            <h2 class="tgm-facet__title">{{ label }}</h2>
            <ul>
              {% for link in facets[name] %}
                <li><a href="{{ link.url }}" data-tgm-ajax{% if link.active %} aria-current="true" class="is-active"{% endif %}>{{ link.label }} <span class="tgm-count">{{ link.count }}</span></a></li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      {% endfor %}
    </aside>
    <div class="tgm-results" aria-live="polite" data-tgm-results>
      <p class="tgm-results__count">{% trans %}{{ total }} tool{% plural total %}{{ total }} tools{% endtrans %}</p>
      {% if results %}
        <div class="tgm-grid">{{ results }}</div>
        {{ pager }}
      {% else %}
        <div class="tgm-empty">
          <p>{{ 'No tools match.'|t }}</p>
          {% if filtered %}<p><a href="{{ clear_url }}" data-tgm-ajax>{{ 'Clear all filters'|t }}</a></p>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

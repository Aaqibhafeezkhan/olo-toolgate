<section class="tgm-hero">
  <h1 class="tgm-hero__title">{{ 'Tools for ToolGate, checked and signed.'|t }}</h1>
  <p class="tgm-hero__lead">{{ 'Find a tool package, check what it needs, and install it from your ToolGate console.'|t }}</p>
  <form class="tgm-search" action="{{ search.action }}" method="get" role="search">
    <label class="visually-hidden" for="tgm-home-q">{{ 'Search tools'|t }}</label>
    <input id="tgm-home-q" type="search" name="q" placeholder="{{ 'Search tools, publishers and tags'|t }}" maxlength="200">
    <button type="submit" class="button button--primary">{{ 'Search'|t }}</button>
  </form>
</section>
{% if categories %}
<section class="tgm-section" aria-labelledby="tgm-categories">
  <h2 id="tgm-categories">{{ 'Categories'|t }}</h2>
  <ul class="tgm-tiles">
    {% for category in categories %}
      <li><a class="tgm-tile" href="{{ category.url }}"><span class="tgm-tile__name">{{ category.name }}</span><span class="tgm-tile__count">{% trans %}{{ category.count }} tool{% plural category.count %}{{ category.count }} tools{% endtrans %}</span></a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}
<section class="tgm-section" aria-labelledby="tgm-newest">
  <h2 id="tgm-newest">{{ 'Newest tools'|t }}</h2>
  {% if newest %}<div class="tgm-grid">{{ newest }}</div>{% else %}<p class="tgm-empty">{{ 'No tools are published yet.'|t }}</p>{% endif %}
</section>
{% if examples %}
<section class="tgm-section" aria-labelledby="tgm-examples">
  <h2 id="tgm-examples">{{ 'From verified OLO examples'|t }}</h2>
  <div class="tgm-grid">{{ examples }}</div>
</section>
{% endif %}

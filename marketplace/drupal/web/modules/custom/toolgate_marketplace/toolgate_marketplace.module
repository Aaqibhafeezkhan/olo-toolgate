/**
 * @file
 * Theme hooks and cron for the ToolGate marketplace.
 */

use Drupal\toolgate_marketplace\PublishService;

/**
 * Implements hook_theme().
 */
function toolgate_marketplace_theme(): array {
  return [
    'tgm_card' => ['variables' => ['item' => [], 'compat' => '', 'avatar' => NULL, 'url' => '']],
    'tgm_home' => ['variables' => ['search' => [], 'categories' => [], 'newest' => [], 'examples' => []]],
    'tgm_browse' => ['variables' => ['form' => [], 'facets' => [], 'results' => [], 'total' => 0, 'pager' => [], 'clear_url' => '', 'filtered' => FALSE]],
    'tgm_tool' => ['variables' => ['detail' => [], 'description' => '', 'compat' => '', 'versions' => [], 'key' => NULL, 'use_box' => '', 'avatar' => NULL, 'owner_links' => []]],
    'tgm_publisher' => ['variables' => ['profile' => [], 'bio' => '', 'avatar' => NULL, 'cards' => []]],
    'tgm_steps' => ['variables' => ['current' => 1]],
    'tgm_checks' => ['variables' => ['version' => [], 'errors' => [], 'warnings' => [], 'api_changes' => [], 'tools' => [], 'settings' => [], 'compat' => '', 'next_url' => '', 'discard_url' => '', 'valid' => FALSE]],
    'tgm_about_signing' => ['variables' => ['marketplace' => '', 'keys' => [], 'keys_url' => '']],
    'tgm_seed_status' => ['variables' => ['status' => NULL]],
    'tgm_static' => ['variables' => ['sections' => []]],
  ];
}

/**
 * Implements hook_cron().
 *
 * Drops signed drafts not published within 24 hours, stale uploads and
 * rejected bytes (design §4.3).
 */
function toolgate_marketplace_cron(): void {
  \Drupal::service(PublishService::class)->cleanUp();
}

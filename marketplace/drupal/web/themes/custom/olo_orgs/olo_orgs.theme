/**
 * @file
 * Preprocess for the OLO Orgs theme.
 */

use Drupal\Core\Url;

/**
 * Implements hook_preprocess_page().
 */
function olo_orgs_preprocess_page(array &$variables): void {
  $account = \Drupal::currentUser();
  $base = \Drupal::service('extension.list.theme')->getPath('olo_orgs');
  $variables['logo_url'] = \Drupal::service('file_url_generator')->generateString($base . '/images/logo.png');
  $variables['logo_light_url'] = \Drupal::service('file_url_generator')->generateString($base . '/images/logo-light.png');
  $variables['nav'] = [
    ['title' => t('Browse tools'), 'url' => Url::fromRoute('toolgate_marketplace.browse')->toString()],
    ['title' => t('Publishers'), 'url' => Url::fromRoute('toolgate_marketplace.publishers')->toString()],
    ['title' => t('Docs'), 'url' => 'https://github.com/olo-labs/olo-toolgate/blob/main/TOOL-SDK-GUIDE.md'],
  ];
  $variables['publish_url'] = Url::fromRoute('toolgate_marketplace.publish')->toString();
  $variables['account_links'] = $account->isAuthenticated()
    ? [
      ['title' => t('My packages'), 'url' => Url::fromRoute('toolgate_marketplace.my_packages')->toString()],
      ['title' => t('My account'), 'url' => Url::fromRoute('user.page')->toString()],
      ['title' => t('Sign out'), 'url' => Url::fromRoute('user.logout')->toString()],
    ]
    : [
      ['title' => t('Sign in'), 'url' => Url::fromRoute('user.login')->toString()],
    ];
  $variables['footer_links'] = [
    ['title' => t('About signing'), 'url' => Url::fromRoute('toolgate_marketplace.about_signing')->toString()],
    ['title' => t('Terms'), 'url' => Url::fromRoute('toolgate_marketplace.terms')->toString()],
    ['title' => t('Privacy'), 'url' => Url::fromRoute('toolgate_marketplace.privacy')->toString()],
    ['title' => t('Report abuse'), 'url' => \Drupal::moduleHandler()->moduleExists('contact') ? Url::fromRoute('entity.contact_form.canonical', ['contact_form' => 'report_abuse'])->toString() : Url::fromRoute('toolgate_marketplace.terms')->toString()],
    ['title' => t('Contact'), 'url' => \Drupal::moduleHandler()->moduleExists('contact') ? Url::fromRoute('contact.site_page')->toString() : Url::fromRoute('toolgate_marketplace.terms')->toString()],
  ];
  $variables['#cache']['contexts'][] = 'user.roles:authenticated';
}

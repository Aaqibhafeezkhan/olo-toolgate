{
    "name": "olo-labs/olo-orgs-marketplace",
    "description": "OLO Orgs: the ToolGate tool marketplace (Drupal site).",
    "type": "project",
    "license": "Apache-2.0",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.3",
        "drupal/core-composer-scaffold": "~11.4.9",
        "drupal/core-recommended": "~11.4.9",
        "drush/drush": "^13.8",
        "league/commonmark": "^2.7",
        "drupal/gin": "^4",
        "drupal/gin_toolbar": "^2",
        "drupal/admin_toolbar": "^3",
        "drupal/s3fs": "^3",
        "drupal/redis": "^1",
        "drupal/config_readonly": "^1",
        "drupal/token": "^1",
        "drupal/metatag": "^2",
        "drupal/redirect": "^1",
        "drupal/honeypot": "^2",
        "drupal/flood_control": "^3",
        "drupal/seckit": "^2",
        "drupal/password_policy": "^4",
        "drupal/symfony_mailer_lite": "^2"
    },
    "require-dev": {
        "behat/mink": "^1.11",
        "behat/mink-browserkit-driver": "^2.2",
        "colinodell/psr-testlogger": "^1.2",
        "mikey179/vfsstream": "^1.6.11",
        "phpspec/prophecy-phpunit": "^2",
        "phpunit/phpunit": "^11.5.50",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/dom-crawler": "^7.4.12",
        "symfony/error-handler": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/var-dumper": "^7.4"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": false,
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "tbachert/spi": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/sites/default/settings.php": false,
                "[web-root]/sites/default/services.yml": false,
                "[web-root]/sites/development.services.yml": false,
                "[web-root]/INSTALL.txt": false,
                "[web-root]/README.md": false,
                "[web-root]/example.gitignore": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ]
        }
    }
}

# syntax=docker/dockerfile:1.7
# Copyright 2026 OLO Labs
# SPDX-License-Identifier: Apache-2.0
#
# Seed build stage (implementation prompt §3.2 step 1). Builds every Java example package from the unchanged examples
# at image build time; the output is only /seed (packages plus seed-manifest.json). The Drupal image (PR 2) copies it
# to /opt/olo/seed with COPY --from.
#
# Build context: ${TOOLGATE_DIR}. Named context "marketplace": ${MARKETPLACE_DIR}.
#
#   docker build -f "$MARKETPLACE_DIR/seed/Dockerfile.stage" --build-context marketplace="$MARKETPLACE_DIR" \
#     --build-arg TOOLGATE_REVISION="$TOOLGATE_REVISION" --output type=local,dest=out "$TOOLGATE_DIR"
#
# Inside the stage the two trees are laid out as after the split (marketplace/ with ToolGate at marketplace/toolgate),
# so the stage also proves the split layout resolves.

FROM rust:1.94.1-alpine@sha256:77237dd363a0b127bb5ef532c2d64c0deb380b738e43a9c4bdac73398d6d0a08 AS seed-cli
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml VERSION TOOL-SDK-GUIDE.md ./
COPY packages/contracts/rust packages/contracts/rust
COPY packages/contracts/tools packages/contracts/tools
COPY apps/gateway apps/gateway
COPY apps/endpoint-client apps/endpoint-client
COPY apps/tool-host apps/tool-host
COPY tool-sdk/cli tool-sdk/cli
RUN --mount=type=cache,id=marketplace-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=marketplace-cli-target,target=/src/target,sharing=locked \
    cargo build --release --locked -p toolgate-cli --bin toolgate && \
    install -m 0555 target/release/toolgate /toolgate

FROM eclipse-temurin:21-jdk-noble@sha256:70898f0f893a6b772a0f29834d8b022e3ac20b6a0c33a922973cf66342ef56be AS seed-build
ARG TOOLGATE_REVISION=unknown
RUN apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/*
COPY --from=marketplace TOOLGATE_SRC /work/marketplace/TOOLGATE_SRC
COPY --from=marketplace scripts /work/marketplace/scripts
COPY --from=marketplace seed /work/marketplace/seed
COPY --from=marketplace helper/src/main/java /work/marketplace/helper/src/main/java
COPY . /work/marketplace/toolgate
COPY --from=seed-cli /toolgate /usr/local/bin/toolgate
RUN --mount=type=cache,id=marketplace-gradle,target=/root/.gradle \
    echo toolgate >/work/marketplace/TOOLGATE_SRC && \
    TOOLGATE_REVISION="$TOOLGATE_REVISION" TOOLGATE_CLI=/usr/local/bin/toolgate \
    bash /work/marketplace/seed/build-seed.sh /seed

FROM scratch AS seed
COPY --from=seed-build /seed /seed

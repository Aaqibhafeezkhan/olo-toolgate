# OLO Orgs Marketplace settings. Copy to .env for local Compose; in Kubernetes use Secrets and values.
# Never commit real values.

# Public identity
MARKETPLACE_BASE_URL=https://olo-labs.duckdns.org
MARKETPLACE_ID=olo-labs-marketplace
MARKETPLACE_SITE_NAME="OLO Orgs"
# Caddy: the address it serves (a host name gets a certificate; ":80" is plain HTTP on a laptop) and the host name
# it sends on Drupal health checks (the MARKETPLACE_BASE_URL host).
MARKETPLACE_SITE_ADDRESS=olo-labs.duckdns.org
MARKETPLACE_PUBLIC_HOST=olo-labs.duckdns.org

# Limits
MARKETPLACE_MAX_PACKAGE_MB=50
MARKETPLACE_MAX_EXPANDED_MB=200
MARKETPLACE_VALIDATION_TIMEOUT_SECONDS=30

# Seeding
MARKETPLACE_SEED_EXAMPLES=true
MARKETPLACE_SEED_STRICT=false

# Database (external)
MARKETPLACE_DB_DRIVER=pgsql
MARKETPLACE_DB_HOST=db
MARKETPLACE_DB_PORT=5432
MARKETPLACE_DB_NAME=olo_orgs
MARKETPLACE_DB_USER=olo_orgs
MARKETPLACE_DB_PASSWORD=change-me

# Redis
MARKETPLACE_REDIS_HOST=redis
MARKETPLACE_REDIS_PORT=6379

# Object storage (S3-compatible; MinIO locally)
MARKETPLACE_S3_ENDPOINT=http://minio:9000
MARKETPLACE_S3_REGION=us-east-1
MARKETPLACE_S3_BUCKET=olo-orgs
MARKETPLACE_S3_ACCESS_KEY=change-me
MARKETPLACE_S3_SECRET_KEY=change-me

# Drupal. Compose reads the hash salt, helper token and first admin password from deploy/secrets/ (see
# docs/deployment.md); set these only where secrets are passed as plain variables.
# DRUPAL_HASH_SALT=
MARKETPLACE_ADMIN_USER=admin
MARKETPLACE_ADMIN_MAIL=admin@olo-labs.duckdns.org
MARKETPLACE_CONTACT_EMAIL=abuse@olo-labs.duckdns.org
# Comma-separated extra host names the site answers to (the base URL host is always trusted).
MARKETPLACE_TRUSTED_HOSTS=

# Helper (internal only)
MARKETPLACE_HELPER_URL=http://helper:8080
# MARKETPLACE_HELPER_TOKEN=
MARKETPLACE_SIGNING_KEY_ID=olo-marketplace-2026-1
# Earlier keys still listed for old releases after a rotation: keyId:base64PublicKey,...
MARKETPLACE_RETIRED_KEYS=
MARKETPLACE_RESERVED_PREFIXES=olo,ololabs,toolgate,examples
MARKETPLACE_SYSTEM_PUBLISHERS=examples
# Concurrent validations per helper replica; more get 503.
MARKETPLACE_HELPER_THREADS=4

# Mail
MARKETPLACE_SMTP_DSN=smtp://mailpit:1025
MARKETPLACE_MAIL_FROM=noreply@olo-labs.duckdns.org

# The only public entry point. MARKETPLACE_SITE_ADDRESS is the host name (Caddy then gets a certificate) or ":80"
# for plain HTTP on a laptop. Drupal replicas are found by DNS, so `docker compose up --scale drupal=N` needs no
# change here; a replica that fails /health leaves the rotation.
{
	admin off
}

{$MARKETPLACE_SITE_ADDRESS::80} {
	encode zstd gzip

	# Public files (CSS/JS aggregates, image styles) straight from object storage. The private prefix is never served.
	@private path /{$MARKETPLACE_S3_BUCKET:olo-orgs}/s3fs-private/*
	respond @private 404
	@public {
		path /{$MARKETPLACE_S3_BUCKET:olo-orgs}/s3fs-public/*
		method GET HEAD
	}
	handle @public {
		reverse_proxy minio:9000 {
			header_up Host minio:9000
			header_down -Server
			header_down -X-Amz-*
		}
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle {
		reverse_proxy {
			dynamic a drupal 8080 {
				refresh 5s
			}
			lb_policy round_robin
			lb_retries 2
			health_uri /health
			health_headers {
				Host {$MARKETPLACE_PUBLIC_HOST:localhost}
			}
			health_interval 10s
			health_timeout 4s
			trusted_proxies private_ranges
		}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	request_body {
		max_size 64MB
	}
	log {
		output stdout
		format json
	}
}

      "artifactIds": [
        "tool"
      ],
      "descriptor": {
        "businessKey": {
          "namespace": "AGENT",
          "required": false
        },
        "description": "Reads a CSV file from the data directory and returns the rows matching every condition, with chosen columns, sorted. With groupBy it returns one row per group with a count and, with sum, a total.",
        "descriptorGeneration": 1,
        "destinations": [],
        "effect": {
          "destructive": false,
          "openWorld": false,
          "safety": "READ_ONLY"
        },
        "errors": [],
        "execution": {
          "async": false,
          "cancelIfAbandoned": false,
          "maxDurationMs": 30000,
          "stateless": false
        },
        "httpAuth": [],
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "columns": {
              "description": "Columns to return, in order; all columns when omitted",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "descending": {
              "default": false,
              "description": "Sort largest first",
              "type": "boolean"
            },
            "file": {
              "description": "File name in the data directory, such as orders.csv",
              "maxLength": 200,
              "type": "string"
            },
            "groupBy": {
              "description": "Column to group by; returns <column>, count and, with sum, sum",
              "maxLength": 200,
              "type": "string"
            },
            "limit": {
              "default": 100,
              "description": "Most rows to return",
              "maximum": 5000,
              "minimum": 1,
              "type": "integer"
            },
            "sortBy": {
              "description": "Column to sort by; with groupBy also count or sum",
              "maxLength": 200,
              "type": "string"
            },
            "sum": {
              "description": "With groupBy, a numeric column to total per group",
              "maxLength": 200,
              "type": "string"
            },
            "where": {
              "description": "Conditions, all of which must hold. Each is <column><op><value> with op one of = != > >= < <= (numbers compare numerically) or ~ (contains, case-insensitive), such as status=FAILED, amount>500, customer~acme.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        },
        "kind": "SERVER",
        "mcpName": "csv.query",
        "outputSchema": {
          "additionalProperties": false,
          "properties": {
            "columns": {
              "description": "Column names of the rows",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "matchedRows": {
              "description": "Rows that matched the conditions",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "rows": {
              "description": "Result rows, each a list of values in column order",
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "array"
            },
            "totalRows": {
              "description": "Rows read from the file",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "truncated": {
              "description": "True when more results exist than limit allowed",
              "type": "boolean"
            }
          },
          "required": [
            "columns",
            "matchedRows",
            "rows",
            "totalRows",
            "truncated"
          ],
          "type": "object"
        },

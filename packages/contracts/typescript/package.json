{
  "name": "@olo-labs/toolgate-contracts",
  "version": "0.10.0-dev",
  "description": "Shared protocol and data contracts for OLO ToolGate",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/olo-labs/olo-toolgate.git",
    "directory": "packages/contracts/typescript"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "default": "./dist/v2/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "RELEASE-NOTES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json",
    "test": "node --test test/roundtrip.mjs test/roundtrip-v2.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

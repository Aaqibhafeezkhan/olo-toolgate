{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/control.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "ControlSnapshot",
  "$ref": "#/$defs/ControlSnapshot",
  "$defs": {
    "ControlUser": {
      "type": "object",
      "description": "Tenant-scoped users configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "showOnLogin": {
          "type": "boolean",
          "description": "Listed with its generated password on the Quickstart login page. Absent means false."
        },
        "claims": {
          "type": "object",
          "description": "Non-secret attributes passed to tools only when a delegated workload binding lists them in passClaims.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision"
      ]
    },
    "ControlUserPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlUser"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlTeam": {
      "type": "object",
      "description": "Tenant-scoped teams configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "userIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "roleIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "userIds",
        "roleIds"
      ]
    },
    "ControlTeamPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlTeam"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlAgent": {
      "type": "object",
      "description": "Tenant-scoped agents configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "description": "URL-safe name for the scoped MCP routes (/mcp/agent/{slug}, /mcp/agent-group/{slug}); unique per tenant among agents, or among agent groups."
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ownerUserId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "ownerUserId"
      ]
    },
    "ControlAgentPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlAgent"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlTool": {
      "type": "object",
      "description": "Tenant-scoped tools configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "definition": {
          "$ref": "tool.schema.json#/$defs/ToolDefinition"
        },
        "extractorId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "packageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "definition",
        "extractorId",
        "version",
        "packageDigest"
      ]
    },
    "ControlToolPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlTool"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlPolicy": {
      "type": "object",
      "description": "Group-scoped guardrails. ALLOW does not create a grant; BLOCK overrides and ASK accumulates.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "decision": {
          "$ref": "policy.schema.json#/$defs/Decision",
          "enum": [
            "ALLOW",
            "ASK",
            "BLOCK"
          ]
        },
        "scope": {
          "$ref": "enterprise.schema.json#/$defs/EnterpriseScope"
        },
        "teams": {
          "$ref": "enterprise.schema.json#/$defs/GroupSelection"
        },
        "agentGroups": {
          "$ref": "enterprise.schema.json#/$defs/GroupSelection"
        },
        "approverTeams": {
          "$ref": "enterprise.schema.json#/$defs/GroupSelection"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "decision",
        "scope",
        "teams",
        "agentGroups",
        "approverTeams"
      ]
    },
    "ControlPolicyPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlPolicy"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlDevice": {
      "type": "object",
      "description": "Tenant-scoped devices configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ownerUserId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "ownerUserId"
      ]
    },
    "ControlDevicePage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlDevice"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlSnapshot": {
      "type": "object",
      "description": "Enterprise group graph. Individual ACLs and retired snapshot formats are rejected.",
      "additionalProperties": false,
      "properties": {
        "formatVersion": {
          "type": "integer",
          "const": 2
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "users": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlUser"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlTeam"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlAgent"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlTool"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlPolicy"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlDevice"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlRole"
          },
          "maxItems": 512
        },
        "deviceGroups": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlDeviceGroup"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "agentGroups": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlAgentGroup"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "toolGroups": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlToolGroup"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlAccessGrant"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "delegations": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlDelegation"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "agentDelegations": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlAgentDelegation"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlExecutionBinding"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "extractors": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlResourceExtractor"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "workloadBindings": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlWorkloadBinding"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "identityBindings": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlIdentityBinding"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "deviceEvidence": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlDeviceEvidence"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "settings": {
          "$ref": "../v2/settings.schema.json#/$defs/ControlServerSettingsPatch"
        },
        "requiredIdentities": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlRequiredIdentity"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "visitorPool": {
          "$ref": "control.schema.json#/$defs/ControlVisitorPool"
        },
        "reservedRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        }
      },
      "required": [
        "formatVersion",
        "tenantId",
        "revision",
        "users",
        "teams",
        "agents",
        "tools",
        "policies",
        "devices",
        "roles",
        "deviceGroups",
        "agentGroups",
        "toolGroups",
        "grants",
        "delegations",
        "agentDelegations",
        "bindings",
        "extractors",
        "workloadBindings",
        "identityBindings",
        "deviceEvidence"
      ]
    },
    "ControlImportMode": {
      "type": "string",
      "enum": [
        "MERGE",
        "REPLACE"
      ]
    },
    "ControlImportRequest": {
      "type": "object",
      "description": "Validate and diff before applying a bounded configuration transaction.",
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "control.schema.json#/$defs/ControlSnapshot"
        },
        "mode": {
          "$ref": "control.schema.json#/$defs/ControlImportMode"
        },
        "dryRun": {
          "type": "boolean"
        },
        "identityResolution": {
          "type": "object",
          "description": "Required identity ID to its resolution.",
          "maxProperties": 512,
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,127}$"
          },
          "additionalProperties": {
            "$ref": "control.schema.json#/$defs/ControlIdentityResolution"
          }
        },
        "removeUnlistedMemberships": {
          "type": "boolean",
          "description": "Also remove resolved users from destination teams they are not resolved into. Default false."
        }
      },
      "required": [
        "snapshot",
        "mode",
        "dryRun"
      ]
    },
    "ControlChangeKind": {
      "type": "string",
      "enum": [
        "CREATE",
        "UPDATE",
        "DELETE"
      ]
    },
    "ControlEntityKind": {
      "type": "string",
      "enum": [
        "USER",
        "TEAM",
        "AGENT",
        "TOOL",
        "POLICY",
        "DEVICE",
        "ROLE",
        "DEVICE_GROUP",
        "AGENT_GROUP",
        "TOOL_GROUP",
        "GRANT",
        "DELEGATION",
        "AGENT_DELEGATION",
        "BINDING",
        "EXTRACTOR",
        "WORKLOAD_BINDING",
        "IDENTITY_BINDING",
        "DEVICE_EVIDENCE",
        "SETTINGS"
      ]
    },
    "ControlChange": {
      "type": "object",
      "description": "Deterministic import diff without payload or credential material.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "control.schema.json#/$defs/ControlEntityKind"
        },
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "operation": {
          "$ref": "control.schema.json#/$defs/ControlChangeKind"
        }
      },
      "required": [
        "kind",
        "id",
        "operation"
      ]
    },
    "ControlImportResult": {
      "type": "object",
      "description": "Import validation/diff result with the current tenant revision.",
      "additionalProperties": false,
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlChange"
          },
          "maxItems": 1024,
          "uniqueItems": true
        }
      },
      "required": [
        "applied",
        "revision",
        "changes"
      ]
    },
    "ControlAudit": {
      "type": "object",
      "description": "Append-only mutation metadata; payloads and credentials are excluded.",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "actorId": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "operation": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "target": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requestId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "requestDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "sequence",
        "tenantId",
        "actorId",
        "operation",
        "target",
        "revision",
        "requestId",
        "occurredAt",
        "requestDigest"
      ]
    },
    "ControlAuditPage": {
      "type": "object",
      "description": "Cursor page of audit mutation metadata.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlAudit"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        }
      },
      "required": [
        "items"
      ]
    },
    "UserRole": {
      "type": "string",
      "description": "Organization portal role. Assignment alone is not an identity credential.",
      "enum": [
        "BASIC",
        "ADMINISTRATOR",
        "SUPER_ADMIN"
      ]
    },
    "AdminSession": {
      "type": "object",
      "description": "Server-verified administrator portal session.",
      "additionalProperties": false,
      "properties": {
        "permissions": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z_]*\\.[a-z][a-z_]*$"},
          "maxItems": 256,
          "uniqueItems": true,
          "description": "Server-derived available feature actions; target-specific authorization is rechecked for each request."
        },
        "role": {
          "$ref": "control.schema.json#/$defs/UserRole"
        },
        "bootstrapAdminUserId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "tenantId": {
          "description": "The tenant this session administers; ToolGate is multi-tenant.",
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "tenantName": {
          "description": "Human-readable tenant display name, separate from its immutable UUID.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "role"
      ]
    },
    "ControlRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "portalRole": {
          "$ref": "control.schema.json#/$defs/UserRole"
        },
        "roleType": {
          "$ref": "enterprise.schema.json#/$defs/EnterpriseRoleType"
        },
        "managementRules": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/EnterpriseManagementRule"
          },
          "maxItems": 64
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "portalRole",
        "roleType",
        "managementRules"
      ],
      "description": "Typed role assigned only to compatible groups. Management rules cannot confer runtime access."
    },
    "ControlRolePage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlRole"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlDeviceGroup": {
      "type": "object",
      "description": "Named device group. Membership alone grants no tool execution.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deviceIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "deviceIds"
      ]
    },
    "ControlDeviceGroupPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlDeviceGroup"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlRequiredIdentity": {
      "type": "object",
      "description": "A user ID that exported records reference, with the exported teams it belonged to. IDs only.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "teamIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "teamIds"
      ]
    },
    "ControlVisitorPool": {
      "type": "object",
      "description": "Quickstart demo account pool, read only at install. Never stored as directory records.",
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "teamId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "agentGroupId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "delegationId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "claims": {
          "type": "object",
          "description": "Claim name to values assigned round-robin to pool accounts.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "minItems": 1,
            "maxItems": 512
          }
        },
        "passClaims": {
          "type": "object",
          "description": "Claim name to the tool id or MCP name globs it is passed to; * is allowed only as the last character.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:/-]*\\*?$"
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          }
        }
      },
      "required": [
        "prefix",
        "teamId",
        "agentGroupId"
      ]
    },
    "ControlIdentityResolutionAction": {
      "type": "string",
      "enum": [
        "EXISTING",
        "MAP",
        "PLACEHOLDER"
      ]
    },
    "ControlIdentityResolution": {
      "type": "object",
      "description": "How one required identity is resolved on import. MAP needs targetUserId; teamIds are added, never replaced.",
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "control.schema.json#/$defs/ControlIdentityResolutionAction"
        },
        "targetUserId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "teamIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        }
      },
      "required": [
        "action"
      ]
    },
    "ControlErrorDetailCode": {
      "type": "string",
      "enum": [
        "UNRESOLVED_IDENTITIES",
        "REPLACE_CONFLICTS",
        "ONE_DEVICE_PER_ACCOUNT",
        "REQUIRED_REVIEWS_CHANGE",
        "RATE_LIMITED"
      ]
    },
    "ControlErrorDetail": {
      "type": "object",
      "description": "Error that names what the caller must resolve; IDs only, never payloads.",
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "control.schema.json#/$defs/ControlErrorDetailCode"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "maxItems": 1024
        },
        "requestId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "error"
      ]
    },
    "ControlReviewPolicy": {
      "type": "object",
      "description": "Configuration review threshold in force for new changes.",
      "additionalProperties": false,
      "properties": {
        "requiredReviews": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "requiredReviews"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/client.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "ClientReport",
  "$ref": "#/$defs/ClientReport",
  "$defs": {
    "ClientEnrollmentRequest": {
      "type": "object",
      "description": "Device identity and capabilities. Enrollment credentials travel separately.",
      "additionalProperties": false,
      "properties": {
        "deviceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "clientVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 128
        }
      },
      "required": [
        "deviceId",
        "clientVersion",
        "capabilities"
      ]
    },
    "PackageState": {
      "type": "string",
      "enum": [
        "ABSENT",
        "STAGING",
        "READY",
        "FAILED",
        "REVOKED"
      ]
    },
    "ReportedPackage": {
      "type": "object",
      "description": "Observed package state, distinct from assigned desired state.",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "state": {
          "$ref": "client.schema.json#/$defs/PackageState"
        }
      },
      "required": [
        "packageId",
        "version",
        "state"
      ]
    },
    "DevicePower": {
      "type": "string",
      "description": "Owner-controlled device power switch. OFF is set only by the local user; no server can switch a device on.",
      "enum": [
        "ON",
        "OFF"
      ]
    },
    "ClientReport": {
      "type": "object",
      "description": "Batched report of device inventory and applied desired revision.",
      "additionalProperties": false,
      "properties": {
        "deviceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "clientVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "appliedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "client.schema.json#/$defs/ReportedPackage"
          },
          "maxItems": 1000
        },
        "power": {
          "$ref": "client.schema.json#/$defs/DevicePower"
        }
      },
      "required": [
        "deviceId",
        "clientVersion",
        "appliedRevision",
        "packages"
      ]
    }
  }
}

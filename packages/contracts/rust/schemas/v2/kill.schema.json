{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v2/kill.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "Kill switch events",
  "description": "Grow-only signed kill and recovery events (plan.md §15).",
  "$ref": "#/$defs/KillEvent",
  "$defs": {
    "KillMode": {
      "type": "string",
      "enum": [
        "STOP_NEW",
        "TERMINATE"
      ],
      "description": "Kill mode."
    },
    "KillScopeKind": {
      "type": "string",
      "enum": [
        "PACKAGE",
        "PACKAGE_DIGEST",
        "PUBLISHER",
        "TOOL",
        "POOL",
        "RUNTIME_IMAGE",
        "TENANT"
      ],
      "description": "What a kill covers."
    },
    "KillScope": {
      "type": "object",
      "description": "Kill target. value is absent only for TENANT.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "kill.schema.json#/$defs/KillScopeKind"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "kind"
      ]
    },
    "KillIssuer": {
      "type": "string",
      "enum": [
        "control",
        "control-breakglass"
      ],
      "description": "Event issuer. Only control may issue recovery events."
    },
    "EventId": {
      "type": "string",
      "pattern": "^(control|control-breakglass):[0-9]{1,16}$",
      "description": "<issuer>:<issuer counter>, never reused."
    },
    "KillEvent": {
      "type": "object",
      "description": "Immutable kill event.",
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "$ref": "kill.schema.json#/$defs/EventId"
        },
        "issuer": {
          "$ref": "kill.schema.json#/$defs/KillIssuer"
        },
        "scope": {
          "$ref": "kill.schema.json#/$defs/KillScope"
        },
        "mode": {
          "$ref": "kill.schema.json#/$defs/KillMode"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "issuedAtUnixMs": {
          "$ref": "identifiers.schema.json#/$defs/UnixMs"
        },
        "signature": {
          "$ref": "identifiers.schema.json#/$defs/CompactJws"
        }
      },
      "required": [
        "eventId",
        "issuer",
        "scope",
        "mode",
        "reason",
        "issuedAtUnixMs",
        "signature"
      ]
    },
    "RecoveryEvent": {
      "type": "object",
      "description": "Supersedes kills after two-person review. Issuer is always control.",
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "$ref": "kill.schema.json#/$defs/EventId"
        },
        "issuer": {
          "type": "string",
          "const": "control"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "kill.schema.json#/$defs/EventId"
          },
          "maxItems": 256,
          "minItems": 1,
          "uniqueItems": true
        },
        "reviewers": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 8,
          "minItems": 2,
          "uniqueItems": true
        },
        "issuedAtUnixMs": {
          "$ref": "identifiers.schema.json#/$defs/UnixMs"
        },
        "signature": {
          "$ref": "identifiers.schema.json#/$defs/CompactJws"
        }
      },
      "required": [
        "eventId",
        "issuer",
        "supersedes",
        "reviewers",
        "issuedAtUnixMs",
        "signature"
      ]
    },
    "KillPush": {
      "type": "object",
      "description": "Push to Tool Hosts and clients for running work.",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "authorizationEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kills": {
          "type": "array",
          "items": {
            "$ref": "kill.schema.json#/$defs/KillEvent"
          },
          "maxItems": 1024
        },
        "recoveries": {
          "type": "array",
          "items": {
            "$ref": "kill.schema.json#/$defs/RecoveryEvent"
          },
          "maxItems": 1024
        },
        "signature": {
          "$ref": "identifiers.schema.json#/$defs/CompactJws"
        }
      },
      "required": [
        "tenantId",
        "authorizationEpoch",
        "kills",
        "recoveries",
        "signature"
      ]
    },
    "BreakGlassRequest": {
      "type": "object",
      "description": "Break-glass kill: 2-of-3 operator signatures, adds kills only.",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "kill.schema.json#/$defs/KillScope"
        },
        "mode": {
          "$ref": "kill.schema.json#/$defs/KillMode"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "operatorSignatures": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/CompactJws"
          },
          "maxItems": 3,
          "minItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "scope",
        "mode",
        "reason",
        "operatorSignatures"
      ]
    },
    "KillRequest": {
      "type": "object",
      "description": "Admin kill request; reviewed when the enterprise review workflow is on.",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "kill.schema.json#/$defs/KillScope"
        },
        "mode": {
          "$ref": "kill.schema.json#/$defs/KillMode"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "scope",
        "mode",
        "reason"
      ]
    },
    "RecoveryRequest": {
      "type": "object",
      "description": "Request a reviewed recovery event.",
      "additionalProperties": false,
      "properties": {
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "kill.schema.json#/$defs/EventId"
          },
          "maxItems": 256,
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "supersedes",
        "reason"
      ]
    },
    "KillEventPage": {
      "type": "object",
      "description": "Effective and superseded events.",
      "additionalProperties": false,
      "properties": {
        "kills": {
          "type": "array",
          "items": {
            "$ref": "kill.schema.json#/$defs/KillEvent"
          },
          "maxItems": 1024
        },
        "recoveries": {
          "type": "array",
          "items": {
            "$ref": "kill.schema.json#/$defs/RecoveryEvent"
          },
          "maxItems": 1024
        },
        "authorizationEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kills",
        "recoveries",
        "authorizationEpoch"
      ]
    }
  }
}

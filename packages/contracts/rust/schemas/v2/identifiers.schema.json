{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v2/identifiers.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "ToolGate v2 identifiers",
  "description": "Shared identifier and digest formats for contract set v2.",
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,127}$",
      "maxLength": 128
    },
    "SemanticVersion": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Bare lowercase hex SHA-256, as in v1."
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Algorithm-prefixed digest (tool-sdk/spec/descriptor)."
    },
    "SecretReference": {
      "type": "string",
      "pattern": "^secret://[a-zA-Z0-9][a-zA-Z0-9._/-]{0,255}$",
      "maxLength": 265
    },
    "PackageId": {
      "type": "string",
      "maxLength": 127,
      "pattern": "^[a-z][a-z0-9-]{1,30}(\\.[a-z][a-z0-9-]{1,30}){1,3}$"
    },
    "NamespacePrefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,30}$",
      "description": "Library namespace prefix (composition.md)."
    },
    "ToolLocalName": {
      "type": "string",
      "maxLength": 127,
      "pattern": "^[a-z][a-z0-9_-]{0,47}(\\.[a-z][a-z0-9_-]{0,47}){0,3}$",
      "description": "Tool local name; one extra segment allowed for a library prefix."
    },
    "ToolId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]{1,30}(\\.[a-z][a-z0-9-]{1,30}){1,3}/[a-z][a-z0-9_-]{0,47}(\\.[a-z][a-z0-9_-]{0,47}){0,3}$",
      "description": "<package id>/<tool local name>; also a valid v1 Identifier."
    },
    "McpName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "VariableName": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9]{1,30}\\.)?[A-Za-z][A-Za-z0-9_]{0,63}$",
      "maxLength": 96
    },
    "DeclarationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "ErrorCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "UnixMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds since the Unix epoch."
    },
    "Revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Monotonic revision, starting at 1."
    },
    "CompactJws": {
      "type": "string",
      "maxLength": 32768,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    }
  }
}

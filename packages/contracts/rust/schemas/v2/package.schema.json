{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v2/package.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "Tool package manifest v2",
  "description": "toolgate-package.json in a .tgpkg (platform-requirements.md \u00a77). Credential values are forbidden.",
  "$ref": "#/$defs/PackageManifest",
  "$defs": {
    "PackageKind": {
      "type": "string",
      "enum": [
        "SDK",
        "CONTAINER",
        "OPENAPI",
        "MCP_PROXY"
      ],
      "description": "How the package executes. MCP_PROXY packages are generated by Control from an approved MCP server snapshot: runtime mcp-proxy and exactly one artifact, mcp-proxy.json (McpProxyDocument), referenced by every tool."
    },
    "SdkLanguage": {
      "type": "string",
      "enum": [
        "JAVA",
        "PYTHON",
        "TYPESCRIPT",
        "DOTNET"
      ],
      "description": "SDK language."
    },
    "ProtocolRange": {
      "type": "object",
      "description": "Supported tool protocol range, inclusive.",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "SdkInfo": {
      "type": "object",
      "description": "SDK that built the package.",
      "additionalProperties": false,
      "properties": {
        "language": {
          "$ref": "package.schema.json#/$defs/SdkLanguage"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "protocol": {
          "$ref": "package.schema.json#/$defs/ProtocolRange"
        },
        "descriptorGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      },
      "required": [
        "language",
        "version",
        "protocol",
        "descriptorGeneration"
      ]
    },
    "PackageCompatibility": {
      "type": "object",
      "description": "Version requirements checked at enable.",
      "additionalProperties": false,
      "properties": {
        "contractsVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "minimumToolHostVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "minimumClientVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        }
      },
      "required": [
        "contractsVersion"
      ]
    },
    "RuntimeDeclaration": {
      "type": "object",
      "description": "Language runtime a tool needs.",
      "additionalProperties": false,
      "properties": {
        "runtimeId": {
          "$ref": "identifiers.schema.json#/$defs/DeclarationId"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "baseImageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "runtimeId",
        "language",
        "version"
      ]
    },
    "PackagedArtifact": {
      "type": "object",
      "description": "Executable artifact inside the package; artifactDigest = sha256 over its exact bytes.",
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "$ref": "identifiers.schema.json#/$defs/DeclarationId"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^artifacts/[A-Za-z0-9._/-]+$"
        },
        "artifactDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtimeId": {
          "$ref": "identifiers.schema.json#/$defs/DeclarationId"
        }
      },
      "required": [
        "artifactId",
        "path",
        "artifactDigest",
        "sizeBytes",
        "mediaType"
      ]
    },
    "ToolLimits": {
      "type": "object",
      "description": "Tool resource requests; each at most the platform ceiling (platform-requirements.md \u00a713.5).",
      "additionalProperties": false,
      "properties": {
        "memoryBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxInputBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxArgumentProperties": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": []
    },
    "ToolDefinition": {
      "type": "object",
      "description": "Tool definition v2: the semantic descriptor plus packaging members outside the digest.",
      "additionalProperties": false,
      "properties": {
        "descriptor": {
          "$ref": "descriptor.schema.json#/$defs/ToolDescriptor"
        },
        "toolDescriptorDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "runtimeId": {
          "$ref": "identifiers.schema.json#/$defs/DeclarationId"
        },
        "entryPoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/DeclarationId"
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "limits": {
          "$ref": "package.schema.json#/$defs/ToolLimits"
        }
      },
      "required": [
        "descriptor",
        "toolDescriptorDigest",
        "artifactIds"
      ]
    },
    "MappingKind": {
      "type": "string",
      "enum": [
        "SECRET",
        "GLOBAL",
        "CLAIM",
        "DESTINATION"
      ],
      "description": "Library mapping kind."
    },
    "CompositionMapping": {
      "type": "object",
      "description": "One applied library mapping.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "package.schema.json#/$defs/MappingKind"
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "kind",
        "from",
        "to"
      ]
    },
    "CompositionRecord": {
      "type": "object",
      "description": "A library merged into the package (composition.md \u00a72).",
      "additionalProperties": false,
      "properties": {
        "libraryId": {
          "$ref": "identifiers.schema.json#/$defs/PackageId"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "fragmentDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "namespacePrefix": {
          "$ref": "identifiers.schema.json#/$defs/NamespacePrefix"
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/CompositionMapping"
          },
          "maxItems": 128
        },
        "excluded": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/ToolLocalName"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "narrowed": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/ToolLocalName"
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "libraryId",
        "version",
        "fragmentDigest",
        "namespacePrefix",
        "mappings",
        "excluded",
        "narrowed"
      ]
    },
    "ConnectionRequirement": {
      "type": "object",
      "description": "SaaS connection the package needs (platform-requirements.md \u00a714.3).",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/DeclarationId"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "provider",
        "scopes"
      ]
    },
    "PackageLimits": {
      "type": "object",
      "description": "Package-level ceilings.",
      "additionalProperties": false,
      "properties": {
        "maxTools": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxDescriptorBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "maxTools",
        "maxDescriptorBytes"
      ]
    },
    "PackageManifest": {
      "type": "object",
      "description": "Package manifest v2. v1 manifests stay readable and are upgraded on read.",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 2
        },
        "kind": {
          "$ref": "package.schema.json#/$defs/PackageKind"
        },
        "id": {
          "$ref": "identifiers.schema.json#/$defs/PackageId"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sdk": {
          "$ref": "package.schema.json#/$defs/SdkInfo"
        },
        "compatibility": {
          "$ref": "package.schema.json#/$defs/PackageCompatibility"
        },
        "runtimes": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/RuntimeDeclaration"
          },
          "maxItems": 8
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/ToolDefinition"
          },
          "maxItems": 64
        },
        "descriptorSetDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/PackagedArtifact"
          },
          "maxItems": 128
        },
        "credentialReferences": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/SecretReference"
          },
          "maxItems": 128
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/ConnectionRequirement"
          },
          "maxItems": 16
        },
        "composition": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/CompositionRecord"
          },
          "maxItems": 32
        },
        "limits": {
          "$ref": "package.schema.json#/$defs/PackageLimits"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "version",
        "publisher",
        "compatibility",
        "runtimes",
        "tools",
        "descriptorSetDigest",
        "artifacts",
        "credentialReferences",
        "connections",
        "composition",
        "limits"
      ]
    },
    "PackageVersionState": {
      "type": "string",
      "enum": [
        "UPLOADED",
        "VERIFIED",
        "IN_REVIEW",
        "APPROVED",
        "ROLLING_OUT",
        "ACTIVE",
        "PAUSED",
        "ROLLED_BACK",
        "DEPRECATED",
        "DRAINING",
        "RETIRED",
        "REJECTED",
        "SUSPENDED"
      ],
      "description": "Package version lifecycle state (platform-requirements.md \u00a78.4)."
    },
    "ApiChange": {
      "type": "string",
      "enum": [
        "NONE",
        "PATCH",
        "MINOR",
        "MAJOR"
      ],
      "description": "Minimum SemVer bump the API diff requires (platform-requirements.md \u00a78.3)."
    },
    "SecurityDeltaKind": {
      "type": "string",
      "enum": [
        "PERMISSION",
        "DESTINATION",
        "ROUTE",
        "SECRET",
        "CONNECTION",
        "CLAIM",
        "RUNTIME_TIER",
        "PUBLISHER_KEY",
        "BASE_IMAGE",
        "KIND",
        "EFFECT_SAFETY",
        "BUSINESS_KEY_NAMESPACE",
        "UNCLASSIFIED"
      ],
      "description": "Security delta item kind (platform-requirements.md \u00a78.3)."
    },
    "SecurityDeltaItem": {
      "type": "object",
      "description": "One security delta. UNCLASSIFIED counts as widening.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "package.schema.json#/$defs/SecurityDeltaKind"
        },
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/ToolId"
        },
        "widening": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "kind",
        "widening",
        "summary"
      ]
    },
    "PackageVersion": {
      "type": "object",
      "description": "A tenant's uploaded package version.",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "$ref": "identifiers.schema.json#/$defs/PackageId"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "packageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "descriptorSetDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "state": {
          "$ref": "package.schema.json#/$defs/PackageVersionState"
        },
        "revision": {
          "$ref": "identifiers.schema.json#/$defs/Revision"
        },
        "uploadedAtUnixMs": {
          "$ref": "identifiers.schema.json#/$defs/UnixMs"
        },
        "manifest": {
          "$ref": "package.schema.json#/$defs/PackageManifest"
        }
      },
      "required": [
        "packageId",
        "version",
        "packageDigest",
        "descriptorSetDigest",
        "state",
        "revision",
        "uploadedAtUnixMs"
      ]
    },
    "PackageVersionPage": {
      "type": "object",
      "description": "Package versions.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/PackageVersion"
          },
          "maxItems": 100
        },
        "nextCursor": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        }
      },
      "required": [
        "items"
      ]
    },
    "PackageReview": {
      "type": "object",
      "description": "Review and enable page data: both diffs and the values to fill.",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "$ref": "identifiers.schema.json#/$defs/PackageId"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "packageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "previousPackageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "apiChange": {
          "$ref": "package.schema.json#/$defs/ApiChange"
        },
        "securityDelta": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/SecurityDeltaItem"
          },
          "maxItems": 512
        },
        "bindingDraft": {
          "$ref": "deployment-binding.schema.json#/$defs/DeploymentBinding"
        }
      },
      "required": [
        "packageId",
        "version",
        "packageDigest",
        "apiChange",
        "securityDelta",
        "bindingDraft"
      ]
    },
    "PackageEnableRequest": {
      "type": "object",
      "description": "Enable exactly the reviewed digest with this binding.",
      "additionalProperties": false,
      "properties": {
        "packageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "binding": {
          "$ref": "deployment-binding.schema.json#/$defs/DeploymentBinding"
        },
        "acknowledgedSecurityDelta": {
          "type": "boolean"
        }
      },
      "required": [
        "packageDigest",
        "binding",
        "acknowledgedSecurityDelta"
      ]
    },
    "PackageDeploymentRequest": {
      "type": "object",
      "description": "Deploys an uploaded server package to the Tool Hosts with values for its declared globals. A destination's host is the global its hostSetting names.",
      "additionalProperties": false,
      "properties": {
        "packageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "globals": {
          "type": "object",
          "description": "Global name to value. Undeclared names are refused; a missing global takes its default.",
          "maxProperties": 256
        },
        "hostIds": {
          "type": "array",
          "description": "The Tool Hosts that run this deployment, by host id. Empty or absent means every registered Tool Host. Moving a tool to another device is a redeploy with another host.",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "deviceGroupIds": {
          "type": "array",
          "description": "The Device Groups whose administered Tool Host members run this deployment, resolved live. Mutually exclusive with hostIds; MCP_PROXY deployments use exactly their registration binding Device Group.",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "privateRanges": {
          "type": "array",
          "description": "Operator-approved private CIDRs scoped to one declared destination host and its declared port. No DNS lookup occurs during approval.",
          "items": {
            "$ref": "service-profile.schema.json#/$defs/PrivateRangeApproval"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "destinationTls": {
          "type": "object",
          "description": "Operator trust settings keyed by declared destination ID. Unknown destinations and pin-only platform service TLS are refused.",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "service-profile.schema.json#/$defs/TlsSettings"
          }
        }
      },
      "required": [
        "packageDigest",
        "globals"
      ]
    },
    "PackageDeployment": {
      "type": "object",
      "description": "The package version Tool Hosts run for one package id, with the service profile and globals Control built for it.",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "$ref": "identifiers.schema.json#/$defs/PackageId"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "packageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "revision": {
          "$ref": "identifiers.schema.json#/$defs/Revision"
        },
        "serviceProfileDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "serviceProfileRevision": {
          "$ref": "identifiers.schema.json#/$defs/Revision"
        },
        "globalsDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "toolIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/ToolId"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "deployedAtUnixMs": {
          "$ref": "identifiers.schema.json#/$defs/UnixMs"
        },
        "hostIds": {
          "type": "array",
          "description": "The Tool Hosts that run this deployment, by host id. Empty or absent means every registered Tool Host. Moving a tool to another device is a redeploy with another host.",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "deviceGroupIds": {
          "type": "array",
          "description": "The Device Groups whose administered Tool Host members run this deployment, resolved live. Mutually exclusive with hostIds; MCP_PROXY deployments use exactly their registration binding Device Group.",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "packageId",
        "version",
        "packageDigest",
        "revision",
        "serviceProfileDigest",
        "serviceProfileRevision",
        "globalsDigest",
        "toolIds",
        "deployedAtUnixMs"
      ]
    },
    "PackageDeploymentPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/PackageDeployment"
          },
          "maxItems": 256
        }
      },
      "required": [
        "items"
      ],
      "description": "Current deployments, one per package id."
    },
    "ToolHostAssignment": {
      "type": "object",
      "description": "One deployed tool a Tool Host runs. The host reports it in its check-in as a local tool, so Control places calls for it there.",
      "additionalProperties": false,
      "properties": {
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/ToolId"
        },
        "action": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "enabled": {
          "type": "boolean"
        },
        "inputSchema": {
          "type": "object"
        },
        "toolDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "packageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "toolId",
        "action",
        "description",
        "enabled",
        "inputSchema",
        "toolDigest",
        "packageDigest"
      ]
    },
    "ToolHostAssignments": {
      "type": "object",
      "description": "What a registered Tool Host runs: its tools, and the deployments whose package, service profile and globals it fetches by digest.",
      "additionalProperties": false,
      "properties": {
        "hostId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/ToolHostAssignment"
          },
          "maxItems": 256
        },
        "deployments": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/PackageDeployment"
          },
          "maxItems": 64
        }
      },
      "required": [
        "hostId",
        "tools",
        "deployments"
      ]
    },
    "MarketplaceKey": {
      "type": "object",
      "description": "A Marketplace release signing key Control trusts, by id and SHA-256 fingerprint of its raw Ed25519 public key.",
      "additionalProperties": false,
      "properties": {
        "keyId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "fingerprint": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "keyId",
        "fingerprint"
      ]
    },
    "MarketplaceStatus": {
      "type": "object",
      "description": "Whether this ToolGate reads an OLO Orgs Marketplace. The id, origin and keys are environment-owned settings, absent when disabled.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "marketplaceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "baseUrl": {
          "type": "string",
          "description": "The HTTPS origin Control fetches from; nothing the Marketplace returns changes it.",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/MarketplaceKey"
          },
          "maxItems": 8
        }
      },
      "required": [
        "enabled"
      ]
    },
    "MarketplaceImportRequest": {
      "type": "object",
      "description": "Imports one Marketplace version as an uploaded server package. Control fetches, verifies and stores it; nothing is deployed, enabled or granted.",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "$ref": "identifiers.schema.json#/$defs/PackageId"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        }
      },
      "required": [
        "packageId",
        "version"
      ]
    },
    "ClientReleaseRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Builds the client-tool image for one verified upload and issues its fleet release (ADR 026).",
      "properties": {
        "packageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "packageDigest"
      ]
    },
    "ClientReleaseTool": {
      "type": "object",
      "additionalProperties": false,
      "description": "One export and whether a client device can run it; an unsupported export is never weakened to fit.",
      "properties": {
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/ToolId"
        },
        "supported": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "toolId",
        "supported"
      ]
    },
    "ClientRelease": {
      "type": "object",
      "additionalProperties": false,
      "description": "A client release: the image index pinned by digest, the exact FleetPackageDocument bytes (manifestDigest) and, when Control holds the package-release key, the signed FleetPackageRelease it recorded.",
      "properties": {
        "packageId": {
          "$ref": "identifiers.schema.json#/$defs/PackageId"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "packageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "image": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        },
        "runtimeVersion": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "manifestDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "signed": {
          "type": "boolean"
        },
        "document": {
          "type": "object",
          "description": "The FleetPackageDocument (v1 fleet schema)."
        },
        "documentBase64": {
          "type": "string",
          "maxLength": 43692,
          "description": "The exact document bytes to sign, base64."
        },
        "release": {
          "type": "object",
          "description": "The signed FleetPackageRelease (v1 fleet schema), when Control signed it."
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "package.schema.json#/$defs/ClientReleaseTool"
          },
          "maxItems": 64
        }
      },
      "required": [
        "packageId",
        "version",
        "packageDigest",
        "image",
        "runtimeVersion",
        "manifestDigest",
        "signed",
        "document",
        "documentBase64",
        "tools"
      ]
    }
  }
}

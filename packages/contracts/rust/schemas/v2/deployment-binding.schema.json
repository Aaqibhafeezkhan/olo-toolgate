{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v2/deployment-binding.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "Deployment binding",
  "description": "Where and how one tenant runs one package version (plan.md §8.5). Own format version and revisions.",
  "$ref": "#/$defs/DeploymentBinding",
  "$defs": {
    "TargetKind": {
      "type": "string",
      "enum": [
        "TOOL_HOST_POOL",
        "DEVICE_GROUP"
      ],
      "description": "Execution target kind."
    },
    "DeploymentTarget": {
      "type": "object",
      "description": "Where the package runs.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "deployment-binding.schema.json#/$defs/TargetKind"
        },
        "ids": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": true
        },
        "allowedTiers": {
          "type": "array",
          "items": {
            "$ref": "descriptor.schema.json#/$defs/RuntimeTier"
          },
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "ids",
        "allowedTiers"
      ]
    },
    "DeploymentGrant": {
      "type": "object",
      "description": "Agent Group grant and catalog scope.",
      "additionalProperties": false,
      "properties": {
        "agentGroupId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "toolIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/ToolId"
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "agentGroupId",
        "toolIds"
      ]
    },
    "LimitOverride": {
      "type": "object",
      "description": "Per-tool limit override; at most the platform ceiling.",
      "additionalProperties": false,
      "properties": {
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/ToolId"
        },
        "maxDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "toolId"
      ]
    },
    "RolloutStrategy": {
      "type": "string",
      "enum": [
        "ALL_AT_ONCE",
        "COHORT"
      ],
      "description": "Rollout strategy (plan.md §8.4)."
    },
    "RolloutStep": {
      "type": "object",
      "description": "One exposure step.",
      "additionalProperties": false,
      "properties": {
        "percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "soakSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        }
      },
      "required": [
        "percent",
        "soakSeconds"
      ]
    },
    "RolloutPlan": {
      "type": "object",
      "description": "Rollout plan attached at enable.",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "$ref": "deployment-binding.schema.json#/$defs/RolloutStrategy"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "deployment-binding.schema.json#/$defs/RolloutStep"
          },
          "maxItems": 16
        },
        "autoRollback": {
          "type": "boolean"
        }
      },
      "required": [
        "strategy",
        "steps",
        "autoRollback"
      ]
    },
    "EffectApproval": {
      "type": "object",
      "description": "Reviewed effect class per tool.",
      "additionalProperties": false,
      "properties": {
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/ToolId"
        },
        "effectSafety": {
          "$ref": "descriptor.schema.json#/$defs/EffectSafety"
        },
        "businessKeyNamespace": {
          "$ref": "descriptor.schema.json#/$defs/KeyNamespace"
        },
        "missingKeyPolicy": {
          "$ref": "invocation.schema.json#/$defs/MissingKeyPolicy"
        },
        "approvalId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "toolId",
        "effectSafety",
        "businessKeyNamespace",
        "missingKeyPolicy",
        "approvalId"
      ]
    },
    "DeploymentBinding": {
      "type": "object",
      "description": "Deployment binding.",
      "additionalProperties": false,
      "properties": {
        "bindingFormatVersion": {
          "type": "integer",
          "const": 1
        },
        "bindingId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "revision": {
          "$ref": "identifiers.schema.json#/$defs/Revision"
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "packageId": {
          "$ref": "identifiers.schema.json#/$defs/PackageId"
        },
        "packageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "configRevision": {
          "$ref": "identifiers.schema.json#/$defs/Revision"
        },
        "serviceProfileDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "serviceProfileRevision": {
          "$ref": "identifiers.schema.json#/$defs/Revision"
        },
        "target": {
          "$ref": "deployment-binding.schema.json#/$defs/DeploymentTarget"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "deployment-binding.schema.json#/$defs/DeploymentGrant"
          },
          "maxItems": 128
        },
        "limitOverrides": {
          "type": "array",
          "items": {
            "$ref": "deployment-binding.schema.json#/$defs/LimitOverride"
          },
          "maxItems": 64
        },
        "rolloutPlan": {
          "$ref": "deployment-binding.schema.json#/$defs/RolloutPlan"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "deployment-binding.schema.json#/$defs/EffectApproval"
          },
          "maxItems": 64
        }
      },
      "required": [
        "bindingFormatVersion",
        "bindingId",
        "revision",
        "tenantId",
        "packageId",
        "packageDigest",
        "configRevision",
        "serviceProfileDigest",
        "serviceProfileRevision",
        "target",
        "grants",
        "limitOverrides",
        "rolloutPlan",
        "effects"
      ]
    },
    "ConfigLayer": {
      "type": "string",
      "enum": [
        "PLATFORM_CEILING",
        "ENVIRONMENT",
        "TENANT_POLICY",
        "POOL_OR_DEVICE_GROUP",
        "DEPLOYMENT_BINDING",
        "PACKAGE_DEFAULT"
      ],
      "description": "Precedence layer, highest first (plan.md §8.5)."
    },
    "EffectiveValue": {
      "type": "object",
      "description": "One effective field and the layer it came from.",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {
          "description": "Any JSON value, typed by the declaration it belongs to."
        },
        "layer": {
          "$ref": "deployment-binding.schema.json#/$defs/ConfigLayer"
        },
        "cappedBy": {
          "$ref": "deployment-binding.schema.json#/$defs/ConfigLayer"
        }
      },
      "required": [
        "field",
        "value",
        "layer"
      ]
    },
    "EffectiveDeployment": {
      "type": "object",
      "description": "GET /api/control/v1/deployments/{bindingId}/effective.",
      "additionalProperties": false,
      "properties": {
        "bindingId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "revision": {
          "$ref": "identifiers.schema.json#/$defs/Revision"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "deployment-binding.schema.json#/$defs/EffectiveValue"
          },
          "maxItems": 1024
        }
      },
      "required": [
        "bindingId",
        "revision",
        "values"
      ]
    }
  }
}

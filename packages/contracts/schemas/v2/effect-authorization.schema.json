{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v2/effect-authorization.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "General effect authorization",
  "$ref": "#/$defs/EffectGrantIssue",
  "$defs": {
    "EffectClassification": {
      "type": "string",
      "enum": [
        "READ",
        "WRITE",
        "DESTRUCTIVE",
        "FINANCIAL"
      ]
    },
    "EffectBodyMode": {
      "type": "string",
      "enum": [
        "NONE",
        "CANONICAL_JSON"
      ]
    },
    "EffectIntentBlueprint": {
      "type": "object",
      "description": "Reviewed request blueprint. Values are constants or closed $arg JSON-pointer references; resolved argument data is never interpreted as a template.",
      "additionalProperties": false,
      "properties": {
        "path": {},
        "query": {
          "type": "object",
          "maxProperties": 64
        },
        "headers": {
          "type": "object",
          "maxProperties": 64
        },
        "contentType": {
          "type": "string",
          "maxLength": 256
        },
        "bodyMode": {
          "$ref": "effect-authorization.schema.json#/$defs/EffectBodyMode"
        },
        "body": {}
      },
      "required": [
        "path",
        "query",
        "headers",
        "contentType",
        "bodyMode",
        "body"
      ]
    },
    "RouteEffectPolicy": {
      "type": "object",
      "description": "Operator-reviewed generic route intent. Financial/destructive and declared consent-required routes require immutable exact-effect approval and atomic slot authority.",
      "additionalProperties": false,
      "properties": {
        "routeId": {
          "$ref": "identifiers.schema.json#/$defs/DeclarationId"
        },
        "classification": {
          "$ref": "effect-authorization.schema.json#/$defs/EffectClassification"
        },
        "consentRequired": {
          "type": "boolean"
        },
        "acknowledgedUnfencedRisk": {
          "type": "boolean"
        },
        "intent": {
          "$ref": "effect-authorization.schema.json#/$defs/EffectIntentBlueprint"
        }
      },
      "required": [
        "routeId",
        "classification",
        "consentRequired",
        "acknowledgedUnfencedRisk",
        "intent"
      ]
    },
    "RouteEffectReview": {
      "type": "object",
      "description": "Review stamp created by Control, never accepted from package or worker input.",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "effect-authorization.schema.json#/$defs/RouteEffectPolicy"
        },
        "reviewedBy": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "reviewedAtUnixMs": {
          "$ref": "identifiers.schema.json#/$defs/UnixMs"
        }
      },
      "required": [
        "policy",
        "reviewedBy",
        "reviewedAtUnixMs"
      ]
    },
    "EffectGrantIssue": {
      "type": "object",
      "description": "Request for fresh owner-bound authority. Control independently verifies the signed argument preimage and reconstructs the reviewed request.",
      "additionalProperties": false,
      "properties": {
        "invocationId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "fencingToken": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "invocationPermit": {
          "$ref": "permit.schema.json#/$defs/SignedInvocationPermit"
        },
        "brokerInstanceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "handlerId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "arguments": {
          "type": "object",
          "maxProperties": 1024
        },
        "httpRequestDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "httpRequestManifest": {
          "$ref": "../v1/enterprise.schema.json#/$defs/PreparedHttpRequestManifest"
        }
      },
      "required": [
        "invocationId",
        "fencingToken",
        "invocationPermit",
        "brokerInstanceId",
        "handlerId",
        "arguments",
        "httpRequestDigest",
        "httpRequestManifest"
      ]
    },
    "EffectGrantClaims": {
      "type": "object",
      "description": "Single-owner unfenced authorization. Its lifetime is at most two seconds and never extends the original execution deadline.",
      "additionalProperties": false,
      "properties": {
        "iss": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "aud": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "iat": {
          "$ref": "identifiers.schema.json#/$defs/UnixMs"
        },
        "nbf": {
          "$ref": "identifiers.schema.json#/$defs/UnixMs"
        },
        "exp": {
          "$ref": "identifiers.schema.json#/$defs/UnixMs"
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "invocationId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "fencingToken": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "authorizationEpoch": {
          "$ref": "identifiers.schema.json#/$defs/Revision"
        },
        "effectId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "generation": {
          "$ref": "identifiers.schema.json#/$defs/Revision"
        },
        "authNonce": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "brokerInstanceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "handlerId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "httpRequestDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "profileDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "routeId": {
          "$ref": "identifiers.schema.json#/$defs/DeclarationId"
        },
        "classification": {
          "$ref": "effect-authorization.schema.json#/$defs/EffectClassification"
        }
      },
      "required": [
        "iss",
        "aud",
        "iat",
        "nbf",
        "exp",
        "tenantId",
        "invocationId",
        "fencingToken",
        "authorizationEpoch",
        "effectId",
        "generation",
        "authNonce",
        "brokerInstanceId",
        "handlerId",
        "httpRequestDigest",
        "profileDigest",
        "routeId",
        "classification"
      ]
    },
    "SignedEffectGrant": {
      "type": "object",
      "description": "JWS with the fixed toolgate-effect-grant-v1 type; not interchangeable with admission or service permits.",
      "additionalProperties": false,
      "properties": {
        "jws": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        }
      },
      "required": [
        "jws"
      ]
    },
    "EffectGrant": {
      "type": "object",
      "description": "Issued authority and conservative monotonic send budget, measured from before the issuance request.",
      "additionalProperties": false,
      "properties": {
        "grant": {
          "$ref": "effect-authorization.schema.json#/$defs/SignedEffectGrant"
        },
        "validForMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      },
      "required": [
        "grant",
        "validForMs"
      ]
    },
    "EffectGrantDispatch": {
      "type": "object",
      "description": "One owner may claim the SENDING transition once.",
      "additionalProperties": false,
      "properties": {
        "grant": {
          "$ref": "effect-authorization.schema.json#/$defs/SignedEffectGrant"
        },
        "brokerInstanceId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "handlerId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "grant",
        "brokerInstanceId",
        "handlerId"
      ]
    },
    "EffectGrantDispatchAllowed": {
      "type": "object",
      "description": "Only explicit true permits the single transport send.",
      "additionalProperties": false,
      "properties": {
        "authorized": {
          "type": "boolean"
        }
      },
      "required": [
        "authorized"
      ]
    },
    "EffectConsentMappingKind": {
      "type": "string",
      "enum": [
        "MAPPED_HTTP",
        "NATIVE_MCP"
      ]
    },
    "EffectConsentMappedRequest": {
      "type": "object",
      "description": "Control-reconstructed outbound business request. Contains resolved mapped values, never credentials. Native MCP excludes handler ID and opaque session/protocol headers; these remain bound by the execution grant.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "effect-authorization.schema.json#/$defs/EffectConsentMappingKind"
        },
        "routeId": {
          "$ref": "identifiers.schema.json#/$defs/DeclarationId"
        },
        "classification": {
          "$ref": "effect-authorization.schema.json#/$defs/EffectClassification"
        },
        "scheme": {
          "type": "string",
          "const": "https"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "method": {
          "type": "string",
          "pattern": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "query": {
          "type": "string",
          "maxLength": 8192
        },
        "headers": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "maxLength": 8192
            }
          }
        },
        "contentType": {
          "type": "string",
          "maxLength": 256
        },
        "bodyMode": {
          "$ref": "effect-authorization.schema.json#/$defs/EffectBodyMode"
        },
        "body": {}
      },
      "required": [
        "kind",
        "routeId",
        "classification",
        "scheme",
        "host",
        "port",
        "method",
        "path",
        "query",
        "headers",
        "contentType",
        "bodyMode",
        "body"
      ]
    },
    "EffectConsentSlot": {
      "type": "object",
      "description": "Explicit bounded route allowance. Each distinct effect identity reserves one use atomically with its authorization; another generation of the same identity reuses that use.",
      "additionalProperties": false,
      "properties": {
        "slotIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "request": {
          "$ref": "effect-authorization.schema.json#/$defs/EffectConsentMappedRequest"
        },
        "permittedCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "slotIndex",
        "request",
        "permittedCount"
      ]
    },
    "EffectConsentPreview": {
      "type": "object",
      "description": "Immutable exact-effect preview created by Control from authenticated original arguments and pinned reviewed mappings. Its canonical digest must be explicitly approved; ordinary invocation approval is not exact consent. Validity never exceeds original operation and credential deadlines.",
      "additionalProperties": false,
      "properties": {
        "consentId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "operationId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "runId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/ToolId"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "argumentsDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "../v1/resource.schema.json#/$defs/ResourceDescriptor"
          },
          "maxItems": 512
        },
        "profileDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "notBeforeUnixMs": {
          "$ref": "identifiers.schema.json#/$defs/UnixMs"
        },
        "expiresAtUnixMs": {
          "$ref": "identifiers.schema.json#/$defs/UnixMs"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "effect-authorization.schema.json#/$defs/EffectConsentSlot"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "consentId",
        "tenantId",
        "operationId",
        "runId",
        "toolId",
        "action",
        "argumentsDigest",
        "resources",
        "profileDigest",
        "notBeforeUnixMs",
        "expiresAtUnixMs",
        "slots"
      ]
    },
    "EffectConsentApprovalRequest": {
      "type": "object",
      "description": "Authenticated explicit approval of one immutable preview and revision. No worker-provided replacement intent or validity window is accepted.",
      "additionalProperties": false,
      "properties": {
        "previewDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "expectedRevision": {
          "$ref": "identifiers.schema.json#/$defs/Revision"
        }
      },
      "required": [
        "previewDigest",
        "expectedRevision"
      ]
    },
    "EffectConsentState": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REVOKED"
      ]
    },
    "EffectConsentBinding": {
      "type": "object",
      "additionalProperties": false,
      "description": "Signed admission reference to exact approved consent; never substitutes for current Control authority at the effect boundary.",
      "properties": {
        "consentId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "previewDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "consentId",
        "previewDigest"
      ]
    },
    "EffectConsentView": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scoped exact-effect review presentation, with a revision that changes on approval or revocation.",
      "properties": {
        "preview": {
          "$ref": "effect-authorization.schema.json#/$defs/EffectConsentPreview"
        },
        "previewDigest": {
          "$ref": "identifiers.schema.json#/$defs/Digest"
        },
        "state": {
          "$ref": "effect-authorization.schema.json#/$defs/EffectConsentState"
        },
        "revision": {
          "$ref": "identifiers.schema.json#/$defs/Revision"
        },
        "reviewedBy": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "approvedAtUnixMs": {
          "$ref": "identifiers.schema.json#/$defs/UnixMs"
        }
      },
      "required": [
        "preview",
        "previewDigest",
        "state",
        "revision"
      ]
    }
  }
}

          "maxItems": 64,
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkflowJsonEdge"
          },
          "maxItems": 128,
          "minItems": 1
        },
        "output": {
          "type": "object",
          "maxProperties": 64
        },
        "outputSchema": {
          "type": "object",
          "maxProperties": 64
        }
      },
      "required": [
        "schemaVersion",
        "nodes",
        "edges",
        "output",
        "outputSchema"
      ]

    "WorkflowGraphSelection": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pinned operator-installed native LangGraph factory. Configuration grants no runtime authority.",
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{0,127}$",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$",
          "minLength": 5,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "entryPoint": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "minLength": 1,
          "maxLength": 48
        },
        "config": {
          "type": "object",
          "maxProperties": 64
        }
      },
      "required": [
        "packageId",
        "version",
        "digest",
        "entryPoint",
        "config"
      ]
    },
    "WorkflowJsonNodeKind": {
      "type": "string",
      "enum": [
        "value",
        "agent",
        "model",
        "tool",
        "branch"
      ],
      "description": "Installed JSON node operations. Unsupported executable extensions are refused, never evaluated from profile text."
    },
    "WorkflowJsonBranchRoutes": {
      "type": "object",
      "additionalProperties": false,
      "description": "Boolean branch destinations in the configured graph.",
      "properties": {
        "true": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^(?:[a-z][a-z0-9_-]{0,47}|END)$"
        },
        "false": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^(?:[a-z][a-z0-9_-]{0,47}|END)$"
        }
      },
      "required": [
        "true",
        "false"
      ]
    },
    "WorkflowJsonNode": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pure node declaration; per-run capabilities are injected by the runtime, never captured in topology.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "kind": {
          "$ref": "#/$defs/WorkflowJsonNodeKind"
        },
        "input": {
          "type": "object",
          "maxProperties": 64

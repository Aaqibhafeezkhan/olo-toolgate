{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/execution.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "Managed local execution",
  "$ref": "#/$defs/LocalRuntimeIpcRequest",
  "$defs": {
    "LocalRuntimeKind": {
      "type": "string",
      "enum": [
        "NATIVE",
        "PYTHON",
        "NODE",
        "POWERSHELL",
        "BATCH",
        "SHELL",
        "JAVA_JAR",
        "JAVA_SDK",
        "DOTNET",
        "WASM"
      ],
      "description": "Managed runtime kind. JAVA_SDK runs a Java SDK package artifact over tool protocol v2 as a CLIENT target (ADR 026)."
    },
    "LocalRuntimeState": {
      "type": "string",
      "enum": [
        "MISSING",
        "READY",
        "FAILED",
        "UNSUPPORTED"
      ]
    },
    "LocalRuntimeOperation": {
      "type": "string",
      "enum": [
        "STATUS",
        "PREPARE",
        "INVOKE"
      ]
    },
    "LocalRuntimeLimits": {
      "type": "object",
      "description": "Bounded local sandbox budget; limits never grant host access.",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 32,
          "maximum": 1024
        },
        "maxInputBytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536
        }
      },
      "required": [
        "timeoutMs",
        "memoryMiB",
        "maxInputBytes",
        "maxOutputBytes"
      ]
    },
    "ManagedRuntime": {
      "type": "object",
      "description": "Administrator-selected immutable tool/runtime image; runtime provisioning is not execution authorization.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "kind": {
          "$ref": "#/$defs/LocalRuntimeKind"
        },
        "image": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(sha256:[a-f0-9]{64}|[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64})$"
        },
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        }
      },
      "required": [
        "id",
        "kind",
        "image",
        "version"
      ]
    },
    "LocalToolRegistration": {
      "type": "object",
      "description": "Protected local organization registration, separate from marketplace trust and online Gateway authorization.",
      "additionalProperties": false,
      "properties": {
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "action": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "runtimeId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "entryPoint": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^/opt/tool/[a-z0-9][a-z0-9._/-]*$"
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "limits": {
          "$ref": "#/$defs/LocalRuntimeLimits"
        },
        "authorizationProfile": {
          "$ref": "enterprise.schema.json#/$defs/InstalledAuthorizationProfile"
        }
      },
      "required": [
        "toolId",
        "action",
        "runtimeId",
        "entryPoint",
        "inputSchema",
        "outputSchema",
        "limits",
        "authorizationProfile"
      ]
    },
    "LocalToolInput": {
      "type": "object",
      "description": "One JSON stdin document; arguments never become process command strings.",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "const": 1
        },
        "requestId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "arguments": {
          "type": "object",
          "maxProperties": 32
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "toolId",
        "arguments"
      ]
    },
    "LocalToolOutput": {
      "type": "object",
      "description": "One bounded JSON stdout document; request binding and output schema are verified.",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "const": 1
        },
        "requestId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "output": {
          "type": "object",
          "maxProperties": 32
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "output"
      ]
    },
    "LocalRuntimeStatus": {
      "type": "object",
      "description": "Redacted runtime readiness and capability, never engine output or credential contents.",
      "additionalProperties": false,
      "properties": {
        "runtimeId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "kind": {
          "$ref": "#/$defs/LocalRuntimeKind"
        },
        "state": {
          "$ref": "#/$defs/LocalRuntimeState"
        },
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        }
      },
      "required": [
        "runtimeId",
        "kind",
        "state",
        "version"
      ]
    },
    "LocalRuntimeHealth": {
      "type": "object",
      "description": "Bounded per-service execution counters and sandbox state.",
      "additionalProperties": false,
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "successfulExecutions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedExecutions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runtimes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/LocalRuntimeStatus"
          }
        }
      },
      "required": [
        "ready",
        "successfulExecutions",
        "failedExecutions",
        "runtimes"
      ]
    },
    "LocalRuntimeIpcRequest": {
      "type": "object",
      "description": "OS-authorized additive IPC revision; callers cannot select runtime images, paths or launch arguments.",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "const": 3
        },
        "requestId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "operation": {
          "$ref": "#/$defs/LocalRuntimeOperation"
        },
        "invocation": {
          "$ref": "#/$defs/LocalToolInput"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "operation"
      ]
    },
    "LocalRuntimeIpcResponse": {
      "type": "object",
      "description": "Canonical redacted execution/status response for IPC revision 3.",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "health": {
          "$ref": "#/$defs/LocalRuntimeHealth"
        },
        "result": {
          "$ref": "#/$defs/LocalToolOutput"
        },
        "error": {
          "$ref": "error.schema.json#/$defs/ErrorCode"
        }
      },
      "required": [
        "requestId"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/tool.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "ToolDefinition",
  "$ref": "#/$defs/ToolDefinition",
  "$defs": {
    "ToolAction": {
      "type": "object",
      "description": "Named operation and declared resource kinds.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "resourceKinds": {
          "type": "array",
          "items": {
            "$ref": "resource.schema.json#/$defs/ResourceKind"
          },
          "maxItems": 32
        }
      },
      "required": [
        "name",
        "resourceKinds"
      ]
    },
    "ReconciliationMethod": {
      "type": "string",
      "enum": [
        "DOWNSTREAM_IDEMPOTENCY",
        "STATUS_LOOKUP",
        "MANUAL"
      ],
      "description": "How an unknown outcome of the tool is settled (OLO M5.4)."
    },
    "ToolDefinition": {
      "type": "object",
      "description": "Capability definition. JSON schemas are data, never executable code.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "tool.schema.json#/$defs/ToolAction"
          },
          "maxItems": 128
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "reconciliation": {
          "$ref": "tool.schema.json#/$defs/ReconciliationMethod"
        },
        "businessKeyPolicy": {
          "$ref": "tool.schema.json#/$defs/BusinessKeyPolicy"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "actions",
        "inputSchema",
        "outputSchema"
      ]
    },
    "BusinessKeyNamespace": {
      "type": "string",
      "enum": [
        "AGENT",
        "DELEGATED_USER",
        "TENANT"
      ],
      "description": "Control derives namespace identity from the verified caller; never from arguments."
    },
    "BusinessKeyPolicy": {
      "type": "object",
      "description": "Reviewed admission key policy. Missing policy retains conservative legacy explicit-key behavior.",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "namespace": {
          "$ref": "tool.schema.json#/$defs/BusinessKeyNamespace"
        },
        "argument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "description": "Exact top-level string input field containing the key."
        },
        "dedupeWindowMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000,
          "description": "Optional unkeyed dedupe; cannot replace a required explicit/argument key."
        },
        "retentionMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 31536000000,
          "description": "Reservation retention, default thirty days; snapshotted at creation, never shortened on replay."
        },
        "upstreamIdempotencyWindowMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 31536000000,
          "description": "Declared downstream key window; retention must cover it."
        }
      },
      "required": [
        "required",
        "namespace"
      ]
    }
  }
}

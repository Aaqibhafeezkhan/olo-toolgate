{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/local-tools.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "Local tools and public client artifacts",
  "$ref": "#/$defs/LocalToolIpcRequest",
  "$defs": {
    "LocalToolOperation": {
      "type": "string",
      "enum": [
        "CATALOG",
        "CALL"
      ]
    },
    "LocalToolInfo": {
      "type": "object",
      "description": "Local tool boundary for signed managed registrations; validate schema before use.",
      "additionalProperties": false,
      "properties": {
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "action": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "enabled": {
          "type": "boolean"
        },
        "inputSchema": {
          "type": "object"
        },
        "toolDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "packageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "toolId",
        "action",
        "description",
        "enabled",
        "inputSchema",
        "toolDigest",
        "packageDigest"
      ]
    },
    "LocalToolCall": {
      "type": "object",
      "description": "Local tool boundary for signed managed registrations; validate schema before use.",
      "additionalProperties": false,
      "properties": {
        "toolId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "arguments": {
          "type": "object",
          "maxProperties": 8
        }
      },
      "required": [
        "toolId",
        "arguments"
      ]
    },
    "LocalToolIpcRequest": {
      "type": "object",
      "description": "Local tool boundary for signed managed registrations; validate schema before use.",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "const": 2
        },
        "requestId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "operation": {
          "$ref": "local-tools.schema.json#/$defs/LocalToolOperation"
        },
        "invocation": {
          "$ref": "local-tools.schema.json#/$defs/LocalToolCall"
        },
        "agentId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "operation"
      ]
    },
    "LocalToolIpcResponse": {
      "type": "object",
      "description": "Local tool boundary for signed managed registrations; validate schema before use.",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "tools": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "local-tools.schema.json#/$defs/LocalToolInfo"
          }
        },
        "output": {
          "type": "object"
        },
        "error": {
          "$ref": "error.schema.json#/$defs/ErrorCode"
        }
      },
      "required": [
        "requestId"
      ]
    },
    "ClientDownloadArtifact": {
      "type": "object",
      "description": "Local tool boundary for signed managed registrations; validate schema before use.",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "$ref": "endpoint.schema.json#/$defs/ClientPlatform"
        },
        "target": {
          "type": "string",
          "pattern": "^(x86_64|aarch64)-(unknown-linux-gnu|pc-windows-(msvc|gnu)|apple-darwin)$"
        },
        "filename": {
          "type": "string",
          "pattern": "^olo-toolgate-client-[0-9A-Za-z._-]+\\.(zip|tar\\.gz)$",
          "maxLength": 180
        },
        "sha256": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        }
      },
      "required": [
        "platform",
        "target",
        "filename",
        "sha256",
        "bytes"
      ]
    },
    "ClientDownloadManifest": {
      "type": "object",
      "description": "Local tool boundary for signed managed registrations; validate schema before use.",
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "$ref": "local-tools.schema.json#/$defs/ClientDownloadArtifact"
          }
        }
      },
      "required": [
        "version",
        "artifacts"
      ]
    },
    "ClientInstallerArtifact": {
      "type": "object",
      "description": "Unsigned interactive system-service installer; signing is a separate release gate.",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "$ref": "endpoint.schema.json#/$defs/ClientPlatform"
        },
        "target": {
          "type": "string",
          "pattern": "^(x86_64|aarch64)-(unknown-linux-gnu|pc-windows-(msvc|gnu)|apple-darwin)$"
        },
        "filename": {
          "type": "string",
          "pattern": "^olo-toolgate-client-[0-9A-Za-z._-]+\\.(setup\\.exe|dmg|run)$",
          "maxLength": 180
        },
        "sha256": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        }
      },
      "required": [
        "platform",
        "target",
        "filename",
        "sha256",
        "bytes"
      ]
    },
    "ClientInstallerManifest": {
      "type": "object",
      "description": "Local tool boundary for signed managed registrations; validate schema before use.",
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "$ref": "local-tools.schema.json#/$defs/ClientInstallerArtifact"
          }
        }
      },
      "required": [
        "version",
        "artifacts"
      ]
    }
  }
}

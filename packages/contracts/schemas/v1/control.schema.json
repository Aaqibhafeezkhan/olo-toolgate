{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ololabs.io/toolgate/v1/control.schema.json",
  "$comment": "Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0",
  "title": "ControlSnapshot",
  "$ref": "#/$defs/ControlSnapshot",
  "$defs": {
    "ControlUser": {
      "type": "object",
      "description": "Tenant-scoped users configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision"
      ]
    },
    "ControlUserPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlUser"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlTeam": {
      "type": "object",
      "description": "Tenant-scoped teams configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "userIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "roleIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "uniqueItems": true,
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "userIds",
        "roleIds"
      ]
    },
    "ControlTeamPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlTeam"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlAgent": {
      "type": "object",
      "description": "Tenant-scoped agents configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ownerUserId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "ownerUserId"
      ]
    },
    "ControlAgentPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlAgent"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlTool": {
      "type": "object",
      "description": "Tenant-scoped tools configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "definition": {
          "$ref": "tool.schema.json#/$defs/ToolDefinition"
        },
        "extractorId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "version": {
          "$ref": "identifiers.schema.json#/$defs/SemanticVersion"
        },
        "packageDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "definition",
        "extractorId",
        "version",
        "packageDigest"
      ]
    },
    "ControlToolPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlTool"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlPolicy": {
      "type": "object",
      "description": "Group-scoped guardrails. ALLOW does not create a grant; BLOCK overrides and ASK accumulates.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "decision": {
          "$ref": "policy.schema.json#/$defs/Decision",
          "enum": [
            "ALLOW",
            "ASK",
            "BLOCK"
          ]
        },
        "scope": {
          "$ref": "enterprise.schema.json#/$defs/EnterpriseScope"
        },
        "teams": {
          "$ref": "enterprise.schema.json#/$defs/GroupSelection"
        },
        "agentGroups": {
          "$ref": "enterprise.schema.json#/$defs/GroupSelection"
        },
        "approverTeams": {
          "$ref": "enterprise.schema.json#/$defs/GroupSelection"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "decision",
        "scope",
        "teams",
        "agentGroups",
        "approverTeams"
      ]
    },
    "ControlPolicyPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlPolicy"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlDevice": {
      "type": "object",
      "description": "Tenant-scoped devices configuration record. Not a runtime credential or policy grant.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ownerUserId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "ownerUserId"
      ]
    },
    "ControlDevicePage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlDevice"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlSnapshot": {
      "type": "object",
      "description": "Enterprise group graph. Individual ACLs and retired snapshot formats are rejected.",
      "additionalProperties": false,
      "properties": {
        "formatVersion": {
          "type": "integer",
          "const": 2
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "users": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlUser"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlTeam"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlAgent"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlTool"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlPolicy"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlDevice"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlRole"
          },
          "maxItems": 512
        },
        "deviceGroups": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlDeviceGroup"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "agentGroups": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlAgentGroup"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "toolGroups": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlToolGroup"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlAccessGrant"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "delegations": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlDelegation"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "agentDelegations": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlAgentDelegation"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlExecutionBinding"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "extractors": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlResourceExtractor"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "workloadBindings": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlWorkloadBinding"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "identityBindings": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlIdentityBinding"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "deviceEvidence": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/ControlDeviceEvidence"
          },
          "maxItems": 512,
          "uniqueItems": true
        }
      },
      "required": [
        "formatVersion",
        "tenantId",
        "revision",
        "users",
        "teams",
        "agents",
        "tools",
        "policies",
        "devices",
        "roles",
        "deviceGroups",
        "agentGroups",
        "toolGroups",
        "grants",
        "delegations",
        "agentDelegations",
        "bindings",
        "extractors",
        "workloadBindings",
        "identityBindings",
        "deviceEvidence"
      ]
    },
    "ControlImportMode": {
      "type": "string",
      "enum": [
        "MERGE",
        "REPLACE"
      ]
    },
    "ControlImportRequest": {
      "type": "object",
      "description": "Validate and diff before applying a bounded configuration transaction.",
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "control.schema.json#/$defs/ControlSnapshot"
        },
        "mode": {
          "$ref": "control.schema.json#/$defs/ControlImportMode"
        },
        "dryRun": {
          "type": "boolean"
        }
      },
      "required": [
        "snapshot",
        "mode",
        "dryRun"
      ]
    },
    "ControlChangeKind": {
      "type": "string",
      "enum": [
        "CREATE",
        "UPDATE",
        "DELETE"
      ]
    },
    "ControlEntityKind": {
      "type": "string",
      "enum": [
        "USER",
        "TEAM",
        "AGENT",
        "TOOL",
        "POLICY",
        "DEVICE",
        "ROLE",
        "DEVICE_GROUP",
        "AGENT_GROUP",
        "TOOL_GROUP",
        "GRANT",
        "DELEGATION",
        "AGENT_DELEGATION",
        "BINDING",
        "EXTRACTOR",
        "WORKLOAD_BINDING",
        "IDENTITY_BINDING",
        "DEVICE_EVIDENCE"
      ]
    },
    "ControlChange": {
      "type": "object",
      "description": "Deterministic import diff without payload or credential material.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "control.schema.json#/$defs/ControlEntityKind"
        },
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "operation": {
          "$ref": "control.schema.json#/$defs/ControlChangeKind"
        }
      },
      "required": [
        "kind",
        "id",
        "operation"
      ]
    },
    "ControlImportResult": {
      "type": "object",
      "description": "Import validation/diff result with the current tenant revision.",
      "additionalProperties": false,
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlChange"
          },
          "maxItems": 1024,
          "uniqueItems": true
        }
      },
      "required": [
        "applied",
        "revision",
        "changes"
      ]
    },
    "ControlAudit": {
      "type": "object",
      "description": "Append-only mutation metadata; payloads and credentials are excluded.",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenantId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "actorId": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        },
        "operation": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "target": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requestId": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "requestDigest": {
          "$ref": "identifiers.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "sequence",
        "tenantId",
        "actorId",
        "operation",
        "target",
        "revision",
        "requestId",
        "occurredAt",
        "requestDigest"
      ]
    },
    "ControlAuditPage": {
      "type": "object",
      "description": "Cursor page of audit mutation metadata.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlAudit"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        }
      },
      "required": [
        "items"
      ]
    },
    "UserRole": {
      "type": "string",
      "description": "Organization portal role. Assignment alone is not an identity credential.",
      "enum": [
        "BASIC",
        "ADMINISTRATOR",
        "SUPER_ADMIN"
      ]
    },
    "AdminSession": {
      "type": "object",
      "description": "Server-verified administrator portal session.",
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "control.schema.json#/$defs/UserRole"
        }
      },
      "required": [
        "role"
      ]
    },
    "ControlRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "portalRole": {
          "$ref": "control.schema.json#/$defs/UserRole"
        },
        "roleType": {
          "$ref": "enterprise.schema.json#/$defs/EnterpriseRoleType"
        },
        "managementRules": {
          "type": "array",
          "items": {
            "$ref": "enterprise.schema.json#/$defs/EnterpriseManagementRule"
          },
          "maxItems": 64
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "portalRole",
        "roleType",
        "managementRules"
      ],
      "description": "Typed role assigned only to compatible groups. Management rules cannot confer runtime access."
    },
    "ControlRolePage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlRole"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    },
    "ControlDeviceGroup": {
      "type": "object",
      "description": "Named device group. Membership alone grants no tool execution.",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "identifiers.schema.json#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deviceIds": {
          "type": "array",
          "items": {
            "$ref": "identifiers.schema.json#/$defs/Identifier"
          },
          "maxItems": 512,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "enabled",
        "revision",
        "deviceIds"
      ]
    },
    "ControlDeviceGroupPage": {
      "type": "object",
      "description": "Cursor page; nextCursor is absent after the last item.",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "control.schema.json#/$defs/ControlDeviceGroup"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "items"
      ]
    }
  }
}

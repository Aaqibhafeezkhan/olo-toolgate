# Select matching reviewed image versions/digests. No credentials in this file.
CONTROL_IMAGE=ololab/olo-toolgate-control:dev
GATEWAY_IMAGE=ololab/olo-toolgate-gateway:dev
# The Quickstart image contains the genuine Tool Host binary; Compose overrides
# its supervisor entrypoint. This does not start another Control or database.
TOOL_HOST_IMAGE=ololab/olo-toolgate-quickstart:dev
# Build the per-tenant-origin runtime with build-runtime.bat before startup.
RUNTIME_IMAGE=olo-toolgate-langgraph-runtime:multitenant-local
POSTGRES_IMAGE=postgres:17-alpine
INGRESS_IMAGE=nginx:stable-alpine

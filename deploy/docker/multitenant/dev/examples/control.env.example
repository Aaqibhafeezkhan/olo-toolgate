# Copyright 2026 OLO Labs; SPDX-License-Identifier: Apache-2.0
# Copy to credentials/control/control.env and supply reviewed private values.
# This is a starting point; retain your installation's signing, fleet, package,
# permit and listener trust settings from the operator guides.
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres:5432/toolgate?sslmode=verify-full&sslrootcert=/etc/toolgate/database-ca.pem
QUARKUS_DATASOURCE_USERNAME=control_app
QUARKUS_DATASOURCE_PASSWORD=REPLACE_WITH_DATABASE_RUNTIME_PASSWORD
QUARKUS_FLYWAY_USERNAME=control_migrator
QUARKUS_FLYWAY_PASSWORD=REPLACE_WITH_DATABASE_MIGRATOR_PASSWORD
TOOLGATE_CONTROL_PLATFORM_USERNAME=control_provisioner
TOOLGATE_CONTROL_PLATFORM_PASSWORD_PATH=/etc/toolgate/platform-password
TOOLGATE_INITIALIZE_MANIFEST=/etc/toolgate/manifest.json
QUARKUS_HTTP_SSL_PORT=8443
QUARKUS_HTTP_INSECURE_REQUESTS=disabled
QUARKUS_HTTP_SSL_CERTIFICATE_FILES=/etc/toolgate/server.crt
QUARKUS_HTTP_SSL_CERTIFICATE_KEY_FILES=/etc/toolgate/server.key
QUARKUS_HTTP_SSL_CLIENT_AUTH=request
QUARKUS_HTTP_SSL_CERTIFICATE_TRUST_STORE_FILE=/etc/toolgate/device-trust.p12
QUARKUS_HTTP_SSL_CERTIFICATE_TRUST_STORE_PASSWORD=REPLACE_WITH_DEVICE_TRUSTSTORE_PASSWORD
MP_JWT_VERIFY_ISSUER=REPLACE_WITH_DESTINATION_ISSUER
MP_JWT_VERIFY_AUDIENCES=toolgate-control
MP_JWT_VERIFY_PUBLICKEY_LOCATION=/etc/toolgate/jwt-public.pem
TOOLGATE_CONTROL_IDENTITY_CUSTODY_ROOT=/etc/toolgate/tenant-identity
TOOLGATE_CONTROL_IDENTITY_PUBLICATION_PATH=/etc/toolgate/publication.json
TOOLGATE_CONTROL_VAULT_WRAPPING_KEY_RING_PATH=/etc/toolgate/vault-wrapping.json
TOOLGATE_CONTROL_ENDPOINT_ENABLED=true
TOOLGATE_CONTROL_FLEET_ENABLED=true
TOOLGATE_TRIGGERS_CONTROL_CORE_ENABLED=true
TOOLGATE_CONTROL_BUNDLE_ENABLED=true
TOOLGATE_CONTROL_BUNDLE_KEY_ID=policy-local
TOOLGATE_CONTROL_BUNDLE_PRIVATE_KEY_PATH=/etc/toolgate/policy.pk8.pem
TOOLGATE_CONTROL_FLEET_KEY_ID=fleet-local
TOOLGATE_CONTROL_FLEET_PRIVATE_KEY_PATH=/etc/toolgate/fleet.pk8.pem
TOOLGATE_CONTROL_EFFECT_KEY_ID=effect-local
TOOLGATE_CONTROL_EFFECT_PRIVATE_KEY_PATH=/etc/toolgate/effect.pk8.pem
TOOLGATE_CONTROL_EFFECT_ISSUER=control
TOOLGATE_CONTROL_EFFECT_AUDIENCE=toolgate-client
TOOLGATE_CONTROL_RUNTIME_BUILDER_ORIGIN=https://graph-builder:19460
TOOLGATE_CONTROL_RUNTIME_BUILDER_IDENTITY_PATH=/etc/toolgate/graph-client.p12
TOOLGATE_CONTROL_RUNTIME_BUILDER_PASSWORD_PATH=/etc/toolgate/graph-client-password
TOOLGATE_CONTROL_RUNTIME_BUILDER_CA_PATH=/etc/toolgate/graph-ca.crt

# Copy to installation.env before startup. Admin sessions retain their short lifetime.
TOOLGATE_RUNTIME_CREDENTIAL_TTL_SECONDS=604800
# Optional local Ollama companion, matching debug/profiled's two-model setup.
# Select Ollama during startup to create its private model trust bundle.
TOOLGATE_WORKFLOW_MODEL_ORIGINS=https://ollama-provider:9443
TOOLGATE_WORKFLOW_MODEL_CA_FILE=/custody/model-ca.pem

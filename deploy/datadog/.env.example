# Datadog organization API key, not an application key. Keep .env private (Git ignores it).
DD_API_KEY=
# Match your account's Datadog site. US1: datadoghq.com; EU: datadoghq.eu;
# US3: us3.datadoghq.com; US5: us5.datadoghq.com; AP1: ap1.datadoghq.com
DD_SITE=datadoghq.com
QUICKSTART_HTTP_PORT=18082
QUICKSTART_TLS_PORT=18482
QUICKSTART_IMAGE=ololab/olo-toolgate-quickstart:dev
TOOLGATE_DEVICE_IMAGE=ololab/olo-toolgate-device:dev

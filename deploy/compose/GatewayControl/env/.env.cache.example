# Copy to .env.cache only when enabling the external cache. Supply protected files in custody/control.
TOOLGATE_CONTROL_CACHE_MODE=redis
TOOLGATE_CONTROL_CACHE_HOST=cache.example.invalid
TOOLGATE_CONTROL_CACHE_PORT=6379
TOOLGATE_CONTROL_CACHE_TLS=true
TOOLGATE_CONTROL_CACHE_USERNAME=default
# Unique to this database/deployment; change after restoring an older database.
TOOLGATE_CONTROL_CACHE_NAMESPACE=toolgate-production
TOOLGATE_CONTROL_CACHE_PASSWORD_PATH=/custody/cache-password
TOOLGATE_CONTROL_CACHE_ENCRYPTION_KEY_PATH=/custody/cache-encryption-key
# Optional private CA; omit to use system trust.
TOOLGATE_CONTROL_CACHE_CA_PATH=/custody/cache-ca.pem
TOOLGATE_CONTROL_CACHE_TIMEOUT_MS=500
TOOLGATE_CONTROL_CACHE_TTL_SECONDS=3600

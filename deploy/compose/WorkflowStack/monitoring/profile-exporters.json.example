{
  "receivers": {
    "otlp": {
      "protocols": {
        "http": {
          "endpoint": "0.0.0.0:4318"
        }
      }
    }
  },
  "processors": {
    "memory_limiter": {
      "check_interval": "1s",
      "limit_mib": 400,
      "spike_limit_mib": 100
    },
    "deltatocumulative": {
      "max_stale": "1h",
      "max_streams": 100000
    },
    "batch": {
      "send_batch_size": 1024,
      "timeout": "5s"
    }
  },
  "exporters": {
    "otlphttp/tempo": {
      "endpoint": "http://tempo:4318"
    },
    "prometheus": {
      "endpoint": "0.0.0.0:8889",
      "add_metric_suffixes": false,
      "send_timestamps": false,
      "metric_expiration": "1h",
      "resource_to_telemetry_conversion": {
        "enabled": true
      }
    },
    "otlphttp/langfuse": {
      "endpoint": "https://cloud.langfuse.com/api/public/otel",
      "headers": {
        "Authorization": "Basic ${env:LANGFUSE_BASIC_AUTH}",
        "x-langfuse-ingestion-version": "4"
      }
    },
    "otlphttp/langsmith": {
      "endpoint": "https://api.smith.langchain.com/otel",
      "headers": {
        "x-api-key": "${env:LANGSMITH_API_KEY}",
        "Langsmith-Agent-Id": "your-registered-agent-id",
        "Langsmith-Agent-Environment": "local"
      }
    }
  },
  "service": {
    "pipelines": {
      "traces": {
        "receivers": [
          "otlp"
        ],
        "processors": [
          "memory_limiter",
          "batch"
        ],
        "exporters": [
          "otlphttp/tempo",
          "otlphttp/langfuse",
          "otlphttp/langsmith"
        ]
      },
      "metrics": {
        "receivers": [
          "otlp"
        ],
        "processors": [
          "memory_limiter",
          "deltatocumulative",
          "batch"
        ],
        "exporters": [
          "prometheus"
        ]
      }
    }
  }
}

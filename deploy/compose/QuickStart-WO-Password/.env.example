QUICKSTART_IMAGE=ololab/olo-toolgate-quickstart:dev
QUICKSTART_HTTP_PORT=8089
QUICKSTART_TLS_PORT=8449
TOOLGATE_DISABLE_ADMIN_PASSWORD=true
TOOLGATE_QUICKSTART_DATABASE_MODE=sqlite
# Optional external cache. Files under ./env are mounted read-only at /external.
TOOLGATE_CONTROL_CACHE_MODE=local
TOOLGATE_CONTROL_CACHE_HOST=
TOOLGATE_CONTROL_CACHE_PORT=6379
TOOLGATE_CONTROL_CACHE_TLS=true
TOOLGATE_CONTROL_CACHE_USERNAME=default
TOOLGATE_CONTROL_CACHE_NAMESPACE=
TOOLGATE_CONTROL_CACHE_PASSWORD_PATH=
TOOLGATE_CONTROL_CACHE_ENCRYPTION_KEY_PATH=
TOOLGATE_CONTROL_CACHE_CA_PATH=
TOOLGATE_CONTROL_CACHE_TIMEOUT_MS=500
TOOLGATE_CONTROL_CACHE_TTL_SECONDS=3600

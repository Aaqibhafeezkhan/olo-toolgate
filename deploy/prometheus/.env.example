# No vendor credentials required. Prometheus UI is bound to localhost.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Local dashboard login defaults to admin / admin.
GRAFANA_ADMIN_PASSWORD=admin
QUICKSTART_HTTP_PORT=18083
QUICKSTART_TLS_PORT=18483
QUICKSTART_IMAGE=ololab/olo-toolgate-quickstart:dev
TOOLGATE_DEVICE_IMAGE=ololab/olo-toolgate-device:dev

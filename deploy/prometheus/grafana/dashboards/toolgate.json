{
  "uid": "toolgate-overview",
  "title": "Tool-call overview",
  "description": "ToolGate Insights aggregate metrics. Rates and increases are estimates from per-minute aggregates, not an individual call ledger.",
  "tags": [
    "toolgate",
    "prometheus"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "toolgate-prometheus"
        },
        "query": {
          "query": "label_values(toolgate_insights_calls{job=\"toolgate-insights\"}, toolgate_tenant_id)",
          "refId": "tenant"
        },
        "definition": "label_values(toolgate_insights_calls{job=\"toolgate-insights\"}, toolgate_tenant_id)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "tool",
        "label": "Tool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "toolgate-prometheus"
        },
        "query": {
          "query": "label_values(toolgate_insights_calls{job=\"toolgate-insights\",toolgate_tenant_id=~\"$tenant\"}, gen_ai_tool_name)",
          "refId": "tool"
        },
        "definition": "label_values(toolgate_insights_calls{job=\"toolgate-insights\",toolgate_tenant_id=~\"$tenant\"}, gen_ai_tool_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Collector scrape health",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toolgate-prometheus"
      },
      "description": "1 = Prometheus can scrape the collector. This does not guarantee recent ToolGate data.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"toolgate-insights\"}",
          "legendFormat": "Collector",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Estimated calls in selected range",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toolgate-prometheus"
      },
      "description": "Estimated from scraped counters; calls before the first scrape may be missed.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(toolgate_insights_calls{job=\"toolgate-insights\",toolgate_tenant_id=~\"$tenant\",gen_ai_tool_name=~\"$tool\"}[$__range]))",
          "legendFormat": "Calls",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Current call rate",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toolgate-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(toolgate_insights_calls{job=\"toolgate-insights\",toolgate_tenant_id=~\"$tenant\",gen_ai_tool_name=~\"$tool\"}[$__rate_interval]))",
          "legendFormat": "Calls/sec",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "p95 execution duration",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toolgate-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(toolgate_insights_duration_bucket{job=\"toolgate-insights\",toolgate_tenant_id=~\"$tenant\",gen_ai_tool_name=~\"$tool\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Call rate by outcome",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toolgate-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (toolgate_outcome) (rate(toolgate_insights_calls{job=\"toolgate-insights\",toolgate_tenant_id=~\"$tenant\",gen_ai_tool_name=~\"$tool\"}[$__rate_interval]))",
          "legendFormat": "{{toolgate_outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Execution duration percentiles",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toolgate-prometheus"
      },
      "description": "Percentiles are noisy with low traffic; missing samples remain empty.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(toolgate_insights_duration_bucket{job=\"toolgate-insights\",toolgate_tenant_id=~\"$tenant\",gen_ai_tool_name=~\"$tool\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(toolgate_insights_duration_bucket{job=\"toolgate-insights\",toolgate_tenant_id=~\"$tenant\",gen_ai_tool_name=~\"$tool\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(toolgate_insights_duration_bucket{job=\"toolgate-insights\",toolgate_tenant_id=~\"$tenant\",gen_ai_tool_name=~\"$tool\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Busiest tools by call rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toolgate-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (gen_ai_tool_name) (rate(toolgate_insights_calls{job=\"toolgate-insights\",toolgate_tenant_id=~\"$tenant\",gen_ai_tool_name=~\"$tool\"}[$__rate_interval])))",
          "legendFormat": "{{gen_ai_tool_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Admission rate by category",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toolgate-prometheus"
      },
      "description": "Filtered by tenant only; admission metrics have no tool label.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (toolgate_admission_category) (rate(toolgate_insights_admissions{job=\"toolgate-insights\",toolgate_tenant_id=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{toolgate_admission_category}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}

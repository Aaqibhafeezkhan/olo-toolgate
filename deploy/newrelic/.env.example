# New Relic INGEST license key, not a user API key. Keep .env private (Git ignores it).
NEW_RELIC_LICENSE_KEY=
# US default. EU: https://otlp.eu01.nr-data.net ; JP: https://otlp.jp.nr-data.net
NEW_RELIC_OTLP_ENDPOINT=https://otlp.nr-data.net
QUICKSTART_HTTP_PORT=18081
QUICKSTART_TLS_PORT=18481
QUICKSTART_IMAGE=ololab/olo-toolgate-quickstart:dev
TOOLGATE_DEVICE_IMAGE=ololab/olo-toolgate-device:dev

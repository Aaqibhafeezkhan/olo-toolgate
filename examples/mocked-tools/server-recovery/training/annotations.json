{
  "tools": {
    "incidents": {
      "phrasings": [
        "What incidents are open?",
        "Show me the {priority} incidents",
        "Any open {priority}s?",
        "List current incidents",
        "What's on fire right now?"
      ],
      "defaultPhrasings": [
        "List the open incidents",
        "What incidents are open?",
        "Show open incidents",
        "Any open incidents?",
        "List incidents",
        "What's currently broken?",
        "incidents?",
        "Show the incident list",
        "Which incidents are active?",
        "What's on fire?",
        "Open incidents please"
      ],
      "parameters": {
        "priority": {
          "phrasings": {
            "P1": [
              "P1",
              "priority 1"
            ],
            "P2": [
              "P2",
              "priority 2"
            ],
            "P3": [
              "P3"
            ],
            "P4": [
              "P4"
            ]
          }
        }
      },
      "negatives": [
        "How should we define P1 versus P2 incidents?",
        "Write an incident postmortem template"
      ]
    },
    "host-status": {
      "phrasings": [
        "What's the status of {host}?",
        "Is {host} up?",
        "Which services are running on {host}?",
        "When did {host} last send a heartbeat?",
        "CPU, memory and disk on {host}?"
      ],
      "parameters": {
        "host": {
          "examples": [
            "app-02",
            "app-01",
            "db-01",
            "web-03",
            "cache-01"
          ]
        }
      },
      "negatives": [
        "What is a heartbeat in monitoring?"
      ]
    },
    "crash-report": {
      "phrasings": [
        "Why did {host} crash?",
        "Crash report for {host}",
        "What caused the last crash on {host}?",
        "Show the crash analysis for {host}",
        "What changed before {host} went down?"
      ],
      "parameters": {
        "host": {
          "examples": [
            "app-02",
            "app-01",
            "db-01",
            "web-03",
            "cache-01"
          ]
        }
      },
      "negatives": [
        "How do I read a Java crash dump?"
      ]
    },
    "runbook": {
      "phrasings": [
        "Runbook for {cause}",
        "How do we recover from {cause}?",
        "What are the steps when a host hits {cause}?",
        "Give me the {cause} recovery procedure"
      ],
      "parameters": {
        "cause": {
          "phrasings": {
            "OOM": [
              "OOM",
              "out of memory"
            ],
            "DISK_FULL": [
              "a full disk",
              "DISK_FULL"
            ],
            "DEADLOCK": [
              "a deadlock",
              "DEADLOCK"
            ],
            "KERNEL_PANIC": [
              "a kernel panic",
              "KERNEL_PANIC"
            ]
          }
        }
      },
      "negatives": [
        "What is a runbook?"
      ]
    },
    "remediate": {
      "phrasings": [
        "{action} {service} on {host}, change {reference}",
        "Fix {host}: {action} for {service} (ref {reference})",
        "On {host}, {action} the {service} service. Step id {reference}",
        "Please {action} {service} on {host}, reference {reference}"
      ],
      "parameters": {
        "host": {
          "examples": [
            "app-02",
            "app-01",
            "db-01",
            "web-03",
            "cache-01"
          ]
        },
        "service": {
          "examples": [
            "checkout-api",
            "nginx",
            "postgres",
            "worker",
            "redis",
            "payments"
          ]
        },
        "reference": {
          "examples": [
            "CHG-1201",
            "INC-5001-step2",
            "CHG-1207",
            "fix-app02-01"
          ]
        },
        "action": {
          "phrasings": {
            "RESTART_SERVICE": [
              "restart",
              "restart the service"
            ],
            "ROLLBACK_DEPLOY": [
              "roll back the last deploy of",
              "rollback"
            ],
            "FAILOVER": [
              "fail over",
              "failover"
            ],
            "CLEAR_TEMP": [
              "clear the temp files for",
              "clean temp space for"
            ]
          }
        }
      },
      "negatives": [
        "Should I restart or roll back after a bad deploy?"
      ]
    },
    "verify": {
      "phrasings": [
        "Did remediation {remediationId} work?",
        "Verify {remediationId}",
        "Run the post-recovery checks for {remediationId}",
        "Is everything healthy after {remediationId}?"
      ],
      "parameters": {
        "remediationId": {
          "examples": [
            "REM-1a2b3c4d",
            "REM-00ff12ab",
            "REM-9c8d7e6f",
            "REM-deadbeef",
            "REM-4e5f6a7b"
          ]
        }
      },
      "negatives": [
        "How do I verify a fix in production safely?"
      ]
    },
    "update-incident": {
      "phrasings": [
        "Mark {incidentId} as {status}: {note} (update {reference})",
        "Set {incidentId} to {status} with note {note}, id {reference}",
        "Update incident {incidentId}: {status}. {note}. Ref {reference}",
        "{incidentId} is {status}. Add to the timeline: {note} ({reference})"
      ],
      "parameters": {
        "incidentId": {
          "examples": [
            "INC-5001",
            "INC-5002",
            "INC-5010",
            "INC-5013"
          ]
        },
        "note": {
          "examples": [
            "Restarted checkout-api, errors dropped",
            "Rolled back release 1.4.2",
            "Disk cleared on app-02",
            "Still investigating the deadlock"
          ]
        },
        "reference": {
          "examples": [
            "UPD-01",
            "upd-5001-3",
            "UPD-17",
            "status-0931"
          ]
        },
        "status": {
          "phrasings": {
            "INVESTIGATING": [
              "investigating",
              "under investigation"
            ],
            "MITIGATED": [
              "mitigated"
            ],
            "RESOLVED": [
              "resolved",
              "fixed"
            ]
          }
        }
      },
      "negatives": [
        "How often should we update stakeholders during an incident?"
      ]
    }
  }
}

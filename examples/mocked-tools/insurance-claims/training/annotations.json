{
  "tools": {
    "policy": {
      "phrasings": [
        "Show insurance policy {policyId}",
        "What does {policyId} cover?",
        "Is {policyId} active?",
        "What's the deductible and limit on {policyId}?",
        "Which perils are excluded from {policyId}?",
        "Who holds policy {policyId}?"

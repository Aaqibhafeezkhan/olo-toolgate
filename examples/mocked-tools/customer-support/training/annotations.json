            "REFUND": [
              "refund"
            ],
            "PRODUCT": [
              "product"
            ],
            "ACCOUNT": [
              "account",
              "login"
            ],
            "OTHER": [
              "general",
              "other"
            ]
          }
        }
      },
      "negatives": [
        "How do I write a good support ticket?",
        "What's a reasonable SLA for support tickets?"

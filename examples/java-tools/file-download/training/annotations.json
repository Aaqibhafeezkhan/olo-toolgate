{
  "tools": {
    "fetch": {
      "phrasings": [
        "Download {path}",
        "Fetch {path} from the file server",
        "Get {path} and save it as {saveAs}",
        "Download {path}, {overwrite}",
        "Grab the file {path} for me",
        "Pull {path} down from the server",
        "Save {path} locally as {saveAs}, {overwrite}",
        "I need {path} downloaded"
      ],
      "defaultPhrasings": [

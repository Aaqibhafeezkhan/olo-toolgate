{
  "tools": {
    "list": {
      "phrasings": [
        "What's in the {folder} folder?",
        "List the files in {folder}",
        "Show me everything in the HotFolder",
        "Which files are in the hot folder?",
        "ls {folder}",
        "What files are waiting in {folder}?"
      ],
      "defaultPhrasings": [
        "List the HotFolder",
        "What files are in the hot folder?",
        "What's in the hot folder?",
        "List everything in the HotFolder",
        "Show all hot folder files",
        "ls the hot folder",
        "Which files are in the HotFolder?",
        "List all files and folders",
        "What's in there?",
        "Show the HotFolder contents",
        "hot folder contents?",
        "List the files"
      ],
      "parameters": {
        "folder": {
          "examples": [
            "inbox",
            "outbox",
            "archive",
            "notes",
            "reports",
            "processed"
          ]
        }
      },
      "negatives": [
        "What is a hot folder workflow?",
        "How do I sort files by date in Explorer?"
      ]
    },
    "read_text": {
      "phrasings": [
        "Read {path}",
        "What does {path} say?",
        "Open {path} and show me the text",
        "Show the contents of {path}",
        "cat {path}"
      ],
      "parameters": {
        "path": {
          "examples": [
            "notes/today.txt",
            "inbox/order-1042.txt",
            "reports/summary.md",
            "config/settings.ini",
            "inbox/readme.txt"
          ]
        }
      },
      "negatives": [
        "How do I read a text file in Python?"
      ]
    },
    "file_info": {
      "phrasings": [
        "Does {path} exist?",
        "How big is {path}?",
        "Check whether {path} is there",
        "File size of {path}?"
      ],
      "parameters": {
        "path": {
          "examples": [
            "inbox/order-1042.txt",
            "reports/summary.md",
            "archive/2026-09.zip",
            "notes/today.txt"
          ]
        }
      },
      "negatives": [
        "What's the largest file size NTFS allows?"
      ]
    },
    "hash": {
      "phrasings": [
        "SHA-256 of {path}",
        "Give me the checksum of {path}",
        "Hash {path}",
        "Compute the sha256 for {path}"

    "mkdir": {
      "phrasings": [
        "Create a folder {path}",
        "Make a new directory called {path}",
        "mkdir {path}",
        "Add a folder {path} in the hot folder"
      ],
      "parameters": {
        "path": {
          "examples": [
            "archive/2026-10",
            "inbox/urgent",
            "reports/q4",
            "processed"
          ]
        }
      },
      "negatives": [
        "How do I create a folder on the desktop?"
      ]
    },
    "move": {
      "phrasings": [
        "Move {path} to {destination}",
        "Rename {path} to {destination}",
        "Put {path} into {destination}",
        "mv {path} {destination}"
      ],
      "parameters": {
        "path": {
          "examples": [
            "inbox/order-1042.txt",
            "notes/today.txt",
            "reports/summary.md"
          ]
        },
        "destination": {
          "examples": [
            "processed/order-1042.txt",
            "archive/today.txt",
            "reports/q4/summary.md"
          ]
        }
      },
      "negatives": [
        "How do I move files between drives?"
      ]
    },
    "copy": {
      "phrasings": [
        "Copy {path} to {destination}",
        "Duplicate {path} as {destination}",
        "Make a copy of {path} at {destination}",
        "cp {path} {destination}"
      ],
      "parameters": {
        "path": {
          "examples": [
            "inbox/order-1042.txt",
            "notes/today.txt",
            "reports/summary.md"
          ]
        },
        "destination": {
          "examples": [
            "archive/order-1042.txt",
            "notes/today-backup.txt",
            "outbox/summary.md"
          ]
        }
      },
      "negatives": [
        "Can you copy-edit this sentence: their going home"
      ]

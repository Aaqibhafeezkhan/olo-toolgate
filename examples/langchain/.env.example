# The same published Quickstart supplies the server AND the Linux client archive.
TOOLGATE_QUICKSTART_IMAGE=ololab/olo-toolgate-quickstart:dev
TOOLGATE_DEVICE_IMAGE=ololab/olo-toolgate-device:dev
TOOLGATE_HTTP_PORT=18091
TOOLGATE_TLS_PORT=18451
# Linux hosts: set these to `id -u` and `id -g`. Windows users can keep 1000.
LOCAL_UID=1000
LOCAL_GID=1000
# Only the AI runner receives a model key. Leave empty for --smoke.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
TOOLGATE_REGISTRY_PORT=18552
# Existing installations: complete first-login changes and provide these privately.
TOOLGATE_ADMIN_USERNAME=admin
TOOLGATE_ADMIN_PASSWORD=
TOOLGATE_REVIEWER1_USERNAME=reviewer-1
TOOLGATE_REVIEWER1_PASSWORD=
TOOLGATE_REVIEWER2_USERNAME=reviewer-2
TOOLGATE_REVIEWER2_PASSWORD=

{
  "schemaVersion": 1,
  "sdkVersion": "0.10.0-dev",
  "id": "examples.builder-hello",
  "name": "Builder Hello World",
  "publisher": "ololabs",
  "version": "1.0.0",
  "tools": [{
    "name": "hello",
    "kind": "SERVER",
    "title": "Hello World",
    "description": "Greet someone",
    "inputs": {"text": {"type": "STRING", "description": "Who to greet", "default": "World", "maxLength": 128}},
    "output": {"message": {"concat": [{"literal": "Hello "}, {"input": "text"}]}},
    "events": [{"level": "info", "message": "Producing greeting"}, {"fraction": 1, "message": "Greeting complete"}]
  }]
}

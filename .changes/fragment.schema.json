{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolGate contributor release-note fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contributor", "changes"],
  "$defs": {
    "person": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
        "github": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["core-contributor", "core-maintainer", "maintainer", "contributor", "author", "reviewer", "tester", "documentation", "release-manager", "product-owner"]}}
      }
    },
    "people": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/person"}},
    "pullRequest": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "object", "additionalProperties": false, "required": ["number"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "title": {"$ref": "#/$defs/prose"},
            "url": {"$ref": "#/$defs/url"},
            "owners": {"$ref": "#/$defs/people"},
            "contributors": {"$ref": "#/$defs/people"},
            "reviewers": {"$ref": "#/$defs/people"}
          }
        }
      ]
    },
    "prose": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "url": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2000}
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "contributor": {"$ref": "#/$defs/person"},
    "changes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "summary"],
        "properties": {
          "type": {"enum": ["breaking", "added", "changed", "fixed", "security", "docs", "internal"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
          "component": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
          "pr": {"type": "integer", "minimum": 1},
          "pullRequests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/pullRequest"}},
          "contributors": {"$ref": "#/$defs/people"},
          "owners": {"$ref": "#/$defs/people"},
          "impact": {"$ref": "#/$defs/prose"},
          "migration": {"$ref": "#/$defs/prose"},
          "audience": {"type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["users", "operators", "developers", "administrators"]}},
          "tickets": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["system", "id", "url"],
              "properties": {
                "system": {"enum": ["jira", "github", "other"]},
                "id": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
                "url": {"$ref": "#/$defs/url"},
                "summary": {"$ref": "#/$defs/prose"},
                "owner": {"$ref": "#/$defs/person"},
                "summaryAuthor": {"$ref": "#/$defs/person"},
                "contributors": {"$ref": "#/$defs/people"}
              }
            }
          }
        }
      }
    }
  }
}

[
  {
    "id": "hotfolder-dispatch",
    "assignment": "hotfolder-inbox",
    "subscription": "configured-workflow",
    "assignmentSpec": {
      "trigger": "examples.hotfolder-watch/new-file",
      "packageVersion": "0.1.0",
      "target": {
        "executor": "CLIENT",
        "deviceGroups": [
          "ReadAndWriteDeviceGroup"
        ]
      },
      "config": {
        "folder": "inbox",
        "extension": ".txt"
      },
      "globals": {},
      "desiredState": "Running"
    },
    "subscriptionSpec": {
      "sources": {
        "assignments": [
          "hotfolder-inbox"
        ]
      },
      "filter": "event.type == 'examples.files.observed.v1'",
      "expiresAtUnixMs": 4102444800000
    }
  }
]

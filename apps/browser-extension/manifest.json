{
  "manifest_version": 3,
  "minimum_chrome_version": "127",
  "name": "ToolGate Connect",
  "version": "1.0.0.1",
  "description": "Connect this computer to the current ToolGate gateway and show setup availability.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "1.0.0-dev.1"
}
